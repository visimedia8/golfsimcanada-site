function sha1(msg) {
  function rotl(n,s) { return n<<s|n>>>32-s; }
  function tohex(i) { for(var h="", s=28; s>=0; s-=4) h += (i>>>s & 0xf).toString(16); return h; }
  var H0=0x67452301,H1=0xEFCDAB89,H2=0x98BADCFE,H3=0x10325476,H4=0xC3D2E1F0;
  var ml=msg.length*8;
  var words=[];
  for(var i=0;i<msg.length;i++) words[i>>2]|=msg.charCodeAt(i)<<(24-(i%4)*8);
  words[ml>>5]|=0x80<<(24-ml%32);
  words[((ml+64>>9)<<4)+15]=ml;
  for(var i=0;i<words.length;i+=16){
    var w=[],a=H0,b=H1,c=H2,d=H3,e=H4;
    for(var t=0;t<80;t++){
      w[t]=t<16?words[i+t]:rotl(w[t-3]^w[t-8]^w[t-14]^w[t-16],1);
      var f=t<20?(b&c|~b&d):t<40?(b^c^d):t<60?(b&c|b&d|c&d):(b^c^d);
      var k=t<20?0x5A827999:t<40?0x6ED9EBA1:t<60?0x8F1BBCDC:0xCA62C1D6;
      var temp=(rotl(a,5)+f+e+k+w[t])|0;
      e=d; d=c; c=rotl(b,30); b=a; a=temp;
    }
    H0=(H0+a)|0; H1=(H1+b)|0; H2=(H2+c)|0; H3=(H3+d)|0; H4=(H4+e)|0;
  }
  return tohex(H0)+tohex(H1)+tohex(H2)+tohex(H3)+tohex(H4);
}
</script>

