<div id="compare-launch-pro" style="display: none;">
    <style>
  :root {
    --columns: 6;
  }

  .launch-pro-title {
    font-family: "industry";
    font-weight: bold;
    text-align: center;
    color: #000;
    font-size: 2.8rem;
    margin-bottom: 1rem;
  }

  #launch-pro-comparison-chart {
    font-family: "acumin-pro-condensed", "Helvetica Neue", Arial, sans-serif;
    margin: 0 -0.75rem 5rem;
    overflow: auto;
    position: relative;
    max-width: 1100px;
    margin: auto;
    margin-bottom: 5rem;
  }

  .launch-monitors-copy-after-compare p {
    padding: 0px 20px;
  }

  #launch-pro-comparison-chart .swipe-to-explore {
    background-color: #c3c3c3;
    width: 9rem !important;
    height: 9rem;
    font-weight: bold;
    border-radius: 100%;
    display: flex;
    line-height: 0.6;
    text-align: center;
    justify-content: center;
    align-items: center;
    flex-direction: column;
    margin: auto;
    position: absolute;
    left: 50%;
    top: 18rem;
    transform: translate(-50%, -50%);
    z-index: 10;
    box-shadow: 0 0px 10px #d4d4d4;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  @media screen and (max-width: 850px) {
    #launch-pro-comparison-chart .swipe-to-explore {
      opacity: 1;
      visibility: visible;
    }

    #launch-pro-comparison-chart.scrolled .swipe-to-explore {
      opacity: 0;
      visibility: hidden;
    }

    #launch-pro-comparison-chart .container {
      opacity: 0.5;
    }

    #launch-pro-comparison-chart.scrolled .container {
      opacity: 1;
    }
  }

  #launch-pro-comparison-chart .swipe-to-explore.scrolled {
    visibility: 0;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }

  #launch-pro-comparison-chart .container {
    min-width: 1000px;
    padding: 2rem 0;
    overflow: visible;
  }

  #launch-pro-comparison-chart .container ul {
    margin: 0;
  }

  #launch-pro-comparison-chart .container ul li {
    display: flex;
    padding: 0.75rem;
    text-align: center;
  }

  @media screen and (max-width: 475px) {
    #launch-pro-comparison-chart .container ul li {
      padding: 0.35rem;
    }
  }

  #launch-pro-comparison-chart .container ul li:nth-child(odd) {
    background-color: #f2f2f2;
  }

  #launch-pro-comparison-chart .container ul li:nth-child(2) {
    background-color: #ffffff;
  }

  #launch-pro-comparison-chart .container ul li:nth-child(1) {
    background-color: #ffffff;
  }

  #launch-pro-comparison-chart .container ul li img {
    max-height: 8rem;
  }

  #launch-pro-comparison-chart .container ul li .product-title {
    font-family: "acumin-pro-condensed", "Helvetica Neue", Arial, sans-serif;
    position: relative;
    display: block;
    color: #8a8c8c;
    font-size: 1rem;
    font-weight: normal;
    margin-top: 1rem;
  }

  #launch-pro-comparison-chart .container ul li .product-title span {
    display: block;
    font-weight: bold;
    color: #000;
    font-size: 1.5rem;
    line-height: 1.3;
  }

  @media screen and (max-width: 475px) {
    #launch-pro-comparison-chart .container ul li .product-title span {
      text-decoration: underline;
    }
  }

  #launch-pro-comparison-chart .container ul li div.top-seller:before {
    content: "Top Seller!";
    text-transform: uppercase;
    color: #fe5000;
    font-weight: bold;
    position: absolute;
    left: 50%;
    top: -2rem;
    transform: translateX(-50%);
    font-size: 1.2rem;
    min-width: 6.8rem;
  }

  #launch-pro-comparison-chart .container ul li div {
    /*width: calc(100% / var(--columns));*/
    width: calc(100%);
    position: relative;
    font-size: 1.2rem;
  }

  @media screen and (max-width: 475px) {
    #launch-pro-comparison-chart .container ul li:nth-child(2) {
      background-color: #ffffff;
    }

    #launch-pro-comparison-chart .container ul li:nth-child(1) {
      background-color: #ffffff;
    }

    #launch-pro-comparison-chart .container ul li div:nth-child(2) {
      order: 6;
    }

    #launch-pro-comparison-chart .container ul li div:nth-child(3) {
      order: 5;
    }

    #launch-pro-comparison-chart .container ul li div:nth-child(4) {
      order: 4;
    }

    #launch-pro-comparison-chart .container ul li div:nth-child(5) {
      order: 3;
    }

    #launch-pro-comparison-chart .container ul li div:nth-child(6) {
      order: 2;
    }
  }

  #launch-pro-comparison-chart .container ul li div.row-title {
    text-align: right;
    min-width: 15rem;
  }

  #launch-pro-comparison-chart .container ul li div.circle:before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 1rem;
    height: 1rem;
    border-radius: 100%;
    border: 3px solid #cccdcd;
  }

  #launch-pro-comparison-chart .container ul li div span.tooltip {
    position: relative;
    color: #fff;
    line-height: 1.1;
    display: inline-block;
    text-align: center;
    font-size: 0.8rem;
    font-weight: bold;
    background-color: #aaa;
    width: 1rem;
    height: 1rem;
    border-radius: 100%;
    cursor: pointer;
  }

  #launch-pro-comparison-chart .container ul li div span.tooltip.center {
    position: absolute;
    top: 50%;
    left: calc(50% + 1.5rem);
    transform: translate(-50%, -50%);
  }

  #launch-pro-comparison-chart .container ul li div span.tooltip.bubble-right:before {
    left: -3rem;
  }

  #launch-pro-comparison-chart .container ul li div span.tooltip:before {
    content: attr(data-tooltip-copy);
    color: #fff;
    position: absolute;
    bottom: 2.5rem;
    left: -7rem;
    background-color: #4a4a4a;
    width: 15rem;
    line-height: 1.2;
    font-size: 1.2rem;
    font-weight: normal;
    padding: 0.7rem;
    border-radius: 10px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  #launch-pro-comparison-chart .container ul li div span.tooltip:after {
    content: "";
    position: absolute;
    bottom: 1.5rem;
    left: -0.5rem;
    width: 1rem;
    height: 1rem;
    border-top: 1rem solid #4a4a4a;
    border-left: 1rem solid transparent;
    border-right: 1rem solid transparent;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease;
  }

  #launch-pro-comparison-chart .container ul li div span.tooltip:hover:before,
  #launch-pro-comparison-chart .container ul li div span.tooltip:hover:after {
    opacity: 1;
    visibility: visible;
  }

  #launch-pro-comparison-chart .container ul li div.circle-filled:before {
    background-color: #fe5000;
    border: 3px solid #fe5000;
  }

  #launch-pro-comparison-chart .container ul li.shop-buttons {
    background-color: transparent;
    margin-top: 1rem;
  }

  h3 {
    color: #000;
    font-size: 24px;
    font-weight: bold;
    text-transform: none;
  }

  h3 span {
    font-family: "acumin-pro-condensed", Arial, Helvetica, sans-serif;
    color: #fe5000;
  }

  #launch-pro-comparison-chart .container ul .package-title {
    display: flex;
    text-align: center;
    flex-direction: column;
    justify-content: flex-start;
    align-items: center;
  }

  .launch-monitors-copy-after-compare {
    text-align: center;
  }

  .launch-monitors-copy-after-compare p {
    margin-top: 60px;
  }
</style>
