<script>
    $(document).ready(function () {
    setTimeout(function () {  // Delays execution by 1 second (1000ms)

        // Define the target images and their corresponding video links
        let targetImages = {
//Wingman HD        
            "https://cdn11.bigcommerce.com/s-ms459ombhg/images/stencil/1280x1280/products/3807/5487/WINGMAN_HD_Carousel_Image_14__39668.1760043621.png?c=2":
            "https://www.youtube.com/watch?v=noMROhC6VQk",
//Launch Pro Simulator Bundle          
            "https://cdn11.bigcommerce.com/s-ms459ombhg/images/stencil/1280x1280/products/3775/5366/LINK-Enabled-Video__14289.1749137856.jpg?c=2":
            "https://www.youtube.com/watch?v=0CWzs8ybU_U",
//LPi Simulator Bundle          
            "https://cdn11.bigcommerce.com/s-ms459ombhg/images/stencil/1280x1280/products/3765/5416/Simulator-Bundle-Video__18288.1749243444.png?c=2":
            "https://www.youtube.com/watch?v=0CWzs8ybU_U",
  //LPi Personal          
            "https://cdn11.bigcommerce.com/s-ms459ombhg/images/stencil/1280x1280/products/2833/4760/LINK-Enabled-Video__93035.1739917347.jpg?c=2":
            "https://www.youtube.com/watch?v=0CWzs8ybU_U",
//LPi Full Simulator
            "https://cdn11.bigcommerce.com/s-ms459ombhg/images/stencil/1280x1280/products/3024/4761/LINK-Enabled-Video__96668.1739917382.jpg?c=2":
            "https://www.youtube.com/watch?v=0CWzs8ybU_U",
//Tour Hybrid
            "https://cdn11.bigcommerce.com/s-ms459ombhg/images/stencil/1280x1280/products/3397/5159/Tour-Hybrid-Video-Thumbnail__38689.1742824716.jpg?c=2": "https://www.youtube.com/watch?v=0CWzs8ybU_U",      
            
            
//A1 video2
            "https://cdn11.bigcommerce.com/s-ms459ombhg/images/stencil/1280x1280/products/3121/4927/BG-DTC-202510S-A1-Slope-Video__37734.1742313563.jpg?c=2": "https://www.youtube.com/watch?v=0CWzs8ybU_U",      
//Pro X3+LINK            
            "https://cdn11.bigcommerce.com/s-ms459ombhg/images/stencil/1280x1280/products/2305/4762/LINK-Enabled-Video__09107.1739917533.jpg?c=2":
            "https://www.youtube.com/watch?v=0CWzs8ybU_U"
        };

        function updateVideoDiv() {
            let figureElement = $("figure.productView-image");
            if (!figureElement.length) return;

            let currentZoomImage = figureElement.attr("data-zoom-image");

            // Remove the existing video button if no match
            $(".video-image-click").remove();

            // If the current image matches a target image, inject the video button
            if (targetImages[currentZoomImage]) {
                let videoDiv = $('<div class="video-image-click"></div>').insertBefore(figureElement);

                // Store the video link in data attribute for the click handler
                videoDiv.attr("data-video-link", targetImages[currentZoomImage]);
            }
        }

        // Click event for the video button
        $(document).on("click", ".video-image-click", function () {
            let videoLink = $(this).attr("data-video-link");
            if (videoLink) {
                $('a.venobox.productView-thumbnail-link.vbox-item[href="' + videoLink + '"]').trigger("click");
            }
        });

        // Observe changes in data-zoom-image
        let observer = new MutationObserver(updateVideoDiv);
        let figureElement = document.querySelector("figure.productView-image");
        if (figureElement) {
            observer.observe(figureElement, { attributes: true, attributeFilter: ["data-zoom-image"] });
        }

        // Trigger update when thumbnails are clicked (since they change the main image)
        $(document).on("click", ".productView-thumbnail-link", function () {
            setTimeout(updateVideoDiv, 300); // Small delay to allow DOM update
        });

        // Initial check after delay
        updateVideoDiv();

    }, 1000); // **1-second delay**
});
   
</script>
