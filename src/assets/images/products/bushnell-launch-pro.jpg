<script>
(function () {
  var STORAGE_KEY = "audiohook_visitor_id";

  // Determine visitor ID
  var visitorId = null;

  if (window.BCData?.customer?.id) {
    // Logged-in user
    visitorId = window.BCData.customer.id.toString();
	}else {
    // Fallback: generate persistent visitor ID
    visitorId = localStorage.getItem(STORAGE_KEY);
    if (!visitorId) {
      visitorId = 'ahvid-' + Math.random().toString(36).substring(2) + Date.now();
      localStorage.setItem(STORAGE_KEY, visitorId);
		console.log ("User not logged in Setting up a unique visitor ID for new user");
    }
  }

  // Fetch user's public IP address
  fetch("https://ipinfo.io/json?token=5a65b3db01853b")
    .then(function(response) { return response.json(); })
    .then(function(data) {
      var ipAddress = data.ip || ""; // default to empty if not available

      var params = new URLSearchParams({
        event_name: "pageview",
        timestamp: new Date().toISOString(), // {EventDate}
        visitor_id: visitorId,               // {VisitorId}
        url: window.location.href,           // {url}
        referrer: document.referrer || "",   // {referrer-url}
        user_agent: navigator.userAgent,     // {UserAgent}
        ip_address: ipAddress                // {IpAddress}
      });

      var img = new Image();
      img.style.display = "none";           // hide the pixel
      img.src = "https://listen.audiohook.com/23da23f2-955b-42b6-ac51-03d0e4fcf2ad/pixel.png?" + params.toString();
    });
})();
</script><script type="text/javascript">
