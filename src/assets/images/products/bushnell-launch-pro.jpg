<script>
    //removing easyzoom
    $(document).ready(function () {
    // Function to remove `.easyzoom-flyout` if it exists
    function removeEasyZoom() {
        $(".easyzoom-flyout").remove();
    }

    // Initial check on page load
    removeEasyZoom();

    // MutationObserver to prevent `.easyzoom-flyout` from being injected into the DOM
    let observer = new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
            mutation.addedNodes.forEach(function (node) {
                if ($(node).hasClass("easyzoom-flyout")) {
                    $(node).remove(); // Remove if it's added dynamically
                }
            });
        });
    });

    // Observe the `body` (or a more specific container if needed)
    observer.observe(document.body, { childList: true, subtree: true });

    // Optional: Remove `.easyzoom-flyout` when clicking inside `.productView-image-wrapper`
    $(document).on("click", ".productView-image-wrapper", function () {
        removeEasyZoom();
    });
});
    </script>


