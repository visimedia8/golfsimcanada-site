        <div class="new-cat-title-section--description"><p class="clp-sub-title">The reimagined Launch Pro Circle B Edition brings our standard tour-level accuracy you expect from Bushnell Golf to each of your practice sessions, helping you understand every swing like never before, in an all new sleek look. <br>
<!--
<button id="open-klaviyo-popup" class="button--primary-round button-large" style=" margin-top: 15px;  margin-bottom: 10px;
">Be The First To Know</button>
</p>



<!-- Hidden popup modal -->
<div id="klaviyo-popup-overlay" style="display:none;">
  <div id="klaviyo-popup-container">
    <div class="klaviyo-form-XXztAn"></div>
    <button id="close-klaviyo-popup">×</button>
  </div>
</div>
<style>
#klaviyo-popup-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}
#klaviyo-popup-container {
  position: relative;
  background: #fff;
  padding: 30px;
  border-radius: 10px;
  max-width: 500px;
  width: 90%;
  box-shadow: 0 5px 25px rgba(0,0,0,0.3);
}
#close-klaviyo-popup {
  position: absolute;
  top: 10px;
  right: 10px;
  border: none;
  background: transparent;
  font-size: 28px;
  cursor: pointer;
  line-height: 1;
}
@media screen and (min-width: 1050px) {
  #bushnell-golf .new-category-grid {
    max-width: 1000px;
  }
  #bushnell-golf .new-category-grid [data-list-name="Category: Launch Monitors"] .product {
    padding-left: 60px !important;
    padding-right: 60px !important;
    padding-bottom: 45px !important;
  }
}
</style>

<script>
document.addEventListener("DOMContentLoaded", function() {
  const openBtn = document.getElementById("open-klaviyo-popup");
  const overlay = document.getElementById("klaviyo-popup-overlay");
  const closeBtn = document.getElementById("close-klaviyo-popup");

  if (!openBtn || !overlay) return;

  // Open popup
  openBtn.addEventListener("click", () => {
    overlay.style.display = "flex";
  });

  // Close popup
  closeBtn.addEventListener("click", () => {
    overlay.style.display = "none";
  });

  // Optional: close on background click
  overlay.addEventListener("click", e => {
    if (e.target === overlay) overlay.style.display = "none";
  });
});
</script>
</div>
