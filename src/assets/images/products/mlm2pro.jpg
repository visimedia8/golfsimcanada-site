            width: 100%;
        }

        .TitleBoxesWrapperBox {
            margin: 0;
            max-width: 100%;
            height: auto;
            padding-bottom: 32px;
        }

        .TitleBoxesWrapperBoxBottom {
            padding: 0 32px;
        }

        .TitleBoxesWrapperBoxTitle {
            font-size: 24px;
            padding-bottom: 12px;
        }

        .TitleBoxesWrapperBoxDesc {
            font-size: 14px;
            margin-bottom: 0;
            min-height: auto;
             
                margin-bottom: 24px;
            
        }

        .PreOrderFaqWrapper span {
            font-size: 40px;
        }

        .TitleBoxesSection {
            padding: 60px 0 24px;
        }

        .TitleBoxesWrapperBoxBottomImg {
            width: auto !important;
            max-width: 100%;
        }
    }

    @media (min-width: 769px) and (max-width: 1181px) {
        .R-MouseScrollWrapper {
            display: none;
        }

        .TitleBoxesWrapperTitle {
            font-size: 72px;
            padding-bottom: 32px;
        }

        .TitleBoxesWrapperBoxTitle {
            font-size: 24px;
            padding-top: 8px;
            padding-bottom: 12px;
        }

        .TitleBoxesWrapperBoxDesc {
            font-size: 14px;
        }

        .TitleBoxesWrapperBox {
            width: 230px;
            max-width: unset;
            height: auto;
            padding-bottom: 24px;
        }

        .TitleBoxesWrapperBoxBottom {
            padding: 0 24px;
        }

        .TitleBoxesSection {
            padding: 80px 0px;
        }

        .TitleBoxesWrapperTitle {
            opacity: 1 !important;
        }
    }

    .TitleBoxesWrapperBoxBottomBtn {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .TitleBoxesWrapperBoxBottomImg {
        position: relative;
        left: 8px;
