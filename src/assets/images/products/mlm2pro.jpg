</header>



<style>
    div#menu_header.sticky {
        position: fixed;
        top: 0;
        width: 100%;
        z-index: 9999;
    }

    
    main#MainContent.sticky-header {
        margin-top: 130px;
    }

    

    .ShopIcons {
        gap: 16px;
        padding-top: 10px;
    }

    div#sub-menu.sticky-submenu {
        position: fixed;
        top: 64px;
        width: 100%;
    }

    footer.Footer {
        z-index: 1;
    }

    div#OpenMenu.sticky-openmenu {
        position: fixed;
        top: 129px;
    }

    header.Header {
        z-index: 999999;
    }

    @media screen and (max-width: 720px) {
        div#sub-menu.sticky-submenu {
            position: fixed;
            top: 60px;
            width: 100%;
            z-index: 9999;
        }

        /*.scroll-trigger:not(.scroll-trigger--offscreen).animate--fade-in {
            z-index: 99999;
        }*/
        div#MobileMenuContainer {
            z-index: 9999999;
        }

        .MobileMenuBg.FlexColumn.JustifyContentSpaceBetween.Active {
            z-index: 999999;
        }

        .HideOnDesktop.JustifyContentSpaceBetween.AlignItemsCenter {
            display: flex !important;
        }
    }
</style>
<script>


    document.addEventListener('DOMContentLoaded', () => {

        document.querySelectorAll('a').forEach(function (link) {
            link.addEventListener('click', function (e) {
                const href = link.getAttribute('href');

                if (href && href.includes('/products/mobile-launch-monitor')) {
                    e.preventDefault();
                    const currency = "SGD";

                    if (currency === 'CAD') {
                        window.location.href = '/products/mlm-mobile-launch-monitor-ca';
                    } else {
                        window.location.href = href;
                    }
                }
            });
        });
    });

    window.onscroll = function () {
        myFunction()
    };

    var header = document.getElementById("menu_header");
    var sticky = header.offsetTop;
    console.log("Sticky", sticky);

    function myFunction() {
        if (window.pageYOffset > sticky) {
            header.classList.add("sticky");
            document.getElementById("MainContent")?.classList.add("sticky-header");
            document.getElementById("sub-menu")?.classList.add("sticky-submenu");
            document.getElementById("OpenMenu")?.classList.add("sticky-openmenu");

        } else {
            header.classList.remove("sticky");
            document.getElementById("MainContent")?.classList.remove("sticky-header");
            document.getElementById("sub-menu")?.classList.remove("sticky-submenu");
            document.getElementById("OpenMenu")?.classList.remove("sticky-openmenu");
        }
    }

    document.addEventListener('DOMContentLoaded', () => {


        if (document.querySelectorAll('.R-BannerContainer').length > 0) {
            var BannerContainer = document.querySelector('.R-BannerContainer');
            BannerContainer.classList.add('show');
        }


        var OpenMenu = document.querySelectorAll('.OpenMenu');
        var Menu = document.getElementById('OpenMenu');
        var ContentMenu = document.querySelectorAll('.ContentMenu');
        var openMenuDiv = document.getElementById('OpenMenu');
        var closeMenuIcon = document.querySelector('.menu-close-icon');

        if (closeMenuIcon) {
            closeMenuIcon.addEventListener('click', function () {
                openMenuDiv.classList.remove('Active');
                OpenMenu.forEach((node) => {
                    node.classList.remove('Active');
                });
            });
        }


        OpenMenu.forEach((node) => {
            node.addEventListener('click', () => {
                var tab = node.getAttribute('tab');
                var width = document.scrollingElement.clientWidth;

                if (width > 719) {
                    if (node.classList.contains('Active')) {
                        OpenMenu.forEach((childNode) => {
                            childNode.classList.remove('Active');
                        });

                        ContentMenu.forEach((childNode) => {
                            childNode.classList.remove('Active');
                        });

                        Menu.classList.remove('Active');
                    } else {
                        OpenMenu.forEach((childNode) => {
                            childNode.classList.remove('Active');
                        });
                        ContentMenu.forEach((childNode) => {
                            childNode.classList.remove('Active');
                        });

                        document.querySelector('.ContentMenu[tab="' + tab + '"]')?.classList.add('Active');
                        node.classList.add('Active');
                        Menu.classList.add('Active');
                    }
                } else {
                    document.querySelector('.Hamburger').classList.toggle('Active');
                    document.querySelector('.MobileMenuBg').classList.toggle('Active');
                    document.querySelector('.MobileMenuContainerProduct').classList.toggle('Active');
                    document.querySelector('html').classList.toggle('disable-scroll');
                    document.querySelector('.Overlay').classList.toggle('Active');

                    const stickyTab = document.querySelector('.StickyHeaderTab');
                    const mobileMenuBg = document.querySelector('.MobileMenuBg');

                    if (stickyTab && mobileMenuBg) {
                        // Set initial z-index
                        const updateZIndex = () => {
                            const zIndex = mobileMenuBg.classList.contains('Active') ? '999' : '999999';
                            stickyTab.style.setProperty('z-index', zIndex, 'important');
                        };

                        updateZIndex();


                        const observer = new MutationObserver(() => updateZIndex());

                        observer.observe(mobileMenuBg, {
                            attributes: true,
                            attributeFilter: ['class']
                        });
                    }


                }
            });

        });

        var StoreButtons = document.querySelectorAll('.StoreList');

        document.addEventListener('click', () => {
            OpenMenu.forEach((childNode) => {
                childNode.classList.remove('Active');
            });

            ContentMenu.forEach((childNode) => {
                childNode.classList.remove('Active');
            });
            Menu?.classList.remove('Active');

            document.querySelectorAll('.StoreListDropDown').forEach((node) => {
                node.parentNode.querySelector('.StoreListDropDown').classList.remove('Active');
            })
        });

        document.querySelector('header').addEventListener('click', (event) => {
            event.stopPropagation();
        });

        StoreButtons.forEach((node) => {
            const dropdownElem = node.parentElement.querySelector('.StoreListDropDown');
            let dropdownTrapFoocus = null;
            if (dropdownElem) {
                dropdownTrapFoocus = new ModalTrapFocus(dropdownElem, () => {
                    node.click();
                    node.focus();
                }, true);
            }

            node.addEventListener('click', (event) => {
                const Dropdown = event.currentTarget.parentNode.querySelector('.StoreListDropDown');
                node.classList.toggle('Active');
                const expanded = JSON.parse(event.currentTarget.getAttribute('aria-expanded') || "false");
                event.currentTarget.setAttribute('aria-expanded', !expanded);
                Dropdown.classList.toggle('Active');
                if (dropdownTrapFoocus) dropdownTrapFoocus.focusFirstElement();
            });
        })

        document.querySelector('.Overlay').height = document.scrollingElement.scrollHeight;

        const handleCloseMenu = () => {
            document.querySelector('.MobileMenuBg').classList.remove('Active');
            document.querySelector('.Hamburger').classList.remove('Active');
            document.querySelector('html').classList.remove('disable-scroll');
            document.querySelector('.Overlay').classList.remove('Active');
            document.querySelector('.MobileMenuContainer').classList.remove('Active');
            document.querySelector('.MobileMenuContainerProduct')?.classList.remove('Active');
            hemburgerMenuBtn.focus();
        }

        const hemburgerMenuBtn = document.querySelector('.Hamburger');
        const menuContainer = document.getElementById('MobileMenuContainer');
        let menuTrapFoocus = null;


        if (menuContainer && typeof ModalTrapFocus !== 'undefined') {
            let menuTrapFoocus = new ModalTrapFocus(menuContainer, handleCloseMenu);
        }

        hemburgerMenuBtn.addEventListener('click', (event) => {
            event.currentTarget.classList.toggle('Active');
            document.querySelector('.MobileMenuBg').classList.toggle('Active');
            document.querySelector('.MobileMenuContainer').classList.toggle('Active');
            document.querySelector('html').classList.toggle('disable-scroll');
            document.querySelector('.Overlay').classList.toggle('Active');
            if (menuTrapFoocus) menuTrapFoocus.focusFirstElement();
        });


        document.querySelectorAll('.CloseMenu').forEach((node) => {
            node.addEventListener('click', handleCloseMenu);
        })
    });
</script>


<script>
document.addEventListener('DOMContentLoaded', function () {

    const currentPath = window.location.pathname.replace(/\/$/, '');

    if (currentPath === '/pages/who-we-are') {

        // Remove Active from all
        document.querySelectorAll('.Menu .TabLink')
            .forEach(li => li.classList.remove('Active'));

        // Match link by pathname (not full URL)
        document.querySelectorAll('.Menu .TabLink a').forEach(link => {

            const linkPath = new URL(link.href).pathname.replace(/\/$/, '');

            if (linkPath === '/pages/who-we-are') {
                link.closest('.TabLink')?.classList.add('Active');
            }

        });
    }

});
</script>
