    .BuildYourBundleCheck + label {
        position: relative;
        cursor: pointer;
        padding: 0;
        margin: 0;
        color: #000 !important;
        font-weight: 700;
        display: flex;
    }

    .BuildYourBundleCheck + label:before,
    .BuildYourBundleCheck ~ label:before {
        content: '';
        margin-right: 10px;
        display: inline-block;
        border-radius: 4px;
        vertical-align: text-top;
        width: 22px;
        height: 22px;
        background: #F7F7F7;
        border: #EDEDED 1px solid;
    }


    .BuildYourBundleCheck:checked + label:before {
        background: #CD1B32;
    }

    .BuildYourBundleCheck:disabled + label {
        color: #b8b8b8;
        cursor: auto;
    }

    .BuildYourBundleCheck:disabled + label:before {
        box-shadow: none;
        background: #ddd;
    }

    .BuildYourBundleCheck:checked + label:after {
        content: '';
        position: absolute;
        left: 6px;
        top: 10px;
        background: white;
        width: 2px;
        height: 2px;
        box-shadow: 2px 0 0 white, 4px 0 0 white, 4px -2px 0 white, 4px -4px 0 white, 4px -6px 0 white, 4px -8px 0 white;
        transform: rotate(45deg);
    }

