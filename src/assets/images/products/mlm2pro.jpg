<script>
    document.addEventListener("DOMContentLoaded", function () {
        const labels = document.querySelectorAll(".radio-button-container");
        const findBoxItems = document.querySelectorAll(".R-FindBox-Item");
        const productNameElement = document.querySelector(".RightbarProductName");
        const firstSlideImg = document.querySelector(".ProductMainGallery .swiper-wrapper .swiper-slide img");


        const titleistAssets = {
            img: "https://cdn.shopify.com/s/files/1/0623/1942/7778/files/Titleist-001.png?v=1743583973",
            text: "Titleist 2025 PRO V1 Golf Balls w/ RPT",
            slide: "https://cdn.shopify.com/s/files/1/0623/1942/7778/files/ProductImage_with_Titleist.png?v=1743584597"
        };

        const callawayAssets = {
            img: "https://cdn.shopify.com/s/files/1/0623/1942/7778/files/Callaway-002.png?v=1743583972",
            text: "Callaway Chrome Tour Golf Balls w/ RPT",
            slide: "https://cdn.shopify.com/s/files/1/0623/1942/7778/files/ProductImage_with_Callaway.png?v=1743584597"
        };

        /*
        const titleistAssets = {
            img: "https://cdn.shopify.com/s/files/1/0623/1942/7778/files/Titleist-001.png?v=1743583973",
            text: "Titleist 2025 PRO V1 Golf Balls w/ RPT",
            slide: "https://cdn.shopify.com/s/files/1/0628/8710/0602/files/mlm2pro-titleist-masters-promo-gallery.png?v=1774852767"
        };

        const callawayAssets = {
            img: "https://cdn.shopify.com/s/files/1/0623/1942/7778/files/Callaway-002.png?v=1743583972",
            text: "Callaway Chrome Tour Golf Balls w/ RPT",
            slide: "https://cdn.shopify.com/s/files/1/0628/8710/0602/files/mlm2pro-callaway-masters-promo-gallery.png?v=1774852767"
        };
        */

        function updateVariantAssets(selectedLabel) {
            if (!productNameElement || !productNameElement.textContent.trim().includes("MLM2PRO")) return;

            const lastItem = findBoxItems[findBoxItems.length - 1];
            if (!lastItem) return;

            const imgExplore = lastItem.querySelector(".img-explore");
            const text5 = lastItem.querySelector(".Text5");

            const labelText = selectedLabel?.textContent?.toLowerCase() || "";
            const isTitleist = labelText.includes("titleist");
            const assets = isTitleist ? titleistAssets : callawayAssets;

            if (imgExplore) imgExplore.src = assets.img;
            if (text5) text5.textContent = assets.text;
            if (firstSlideImg) firstSlideImg.src = assets.slide;
        }

        labels.forEach(label => {
            label.addEventListener("click", () => {

                labels.forEach(l => l.classList.remove("active"));

                label.classList.add("active");

                const radio = label.querySelector("input[type='radio']");
                if (radio) radio.checked = true;

                updateVariantAssets(label);
            });
        });

        const initial = document.querySelector(".radio-button-container.active");
        if (initial) {
            const radio = initial.querySelector("input[type='radio']");
            if (radio) radio.checked = true;
            updateVariantAssets(initial);
        }
        window.addEventListener("load", function () {
            const initial = document.querySelector(".radio-button-container.active");
            if (initial) {
                updateVariantAssets(initial);
            }
        });
    });


</script>
