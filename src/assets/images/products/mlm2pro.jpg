        display: flex;
        flex-direction: column;
        align-items: center;
        max-width: 23%;
        width: 100%;
        min-height: 360px;
         
            height: 100%;
         
        background: #111111;
        border-radius: 12px;
        margin: 0 auto;
        position: relative;
    }

    .TitleBoxesWrapperBox a.linked:before {
        content: '';
        position: absolute;
        top: 0;
        bottom: 0;
        width: 100%;
        left: 0;
    }

    .TitleBoxesWrapperBoxTitle {
        font-family: 'Barlow', sans-serif;
        font-style: normal;
        font-weight: 700;
        font-size: 31px;
        line-height: 120%;
