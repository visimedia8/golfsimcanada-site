        display: block;
        padding: 120px 0 80px;
        background: #000;
    }

    .visually-hidden {
        width: 1px !important;
    }

    .TitleBoxesWrapper {
        display: flex;
        flex-direction: column;
    }

    .TitleBoxesWrapperTitle {
        font-family: acumin-pro-extra-condensed, sans-serif;
        font-style: italic;
        font-weight: 700;
        font-size: 96px;
        line-height: 90%;
