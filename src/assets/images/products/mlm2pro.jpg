<!-- new layout -->
<div>
    
<div id="shopify-section-new-header" class="shopify-section header"><style>
    .BlackHeader {
        padding-right: 0;
    }

    .StoreList.Active .BarlowSemibold {
        color: #CD1B32;
    }

    .StoreList.Active svg {
        transform: rotate(180deg);
    }

    .StoreList.Active svg path {
        stroke: #CD1B32;
    }

    #menu_header {
        padding: 0 32px;
    }

    @media (max-width: 990px) {
        .Row.Boxed {
            padding: 0 32px;
        }
    }

    @media (max-width: 720px) {
        .MobileContainerMenu {
            padding: 0 16px;
        }

        .MobileMenuLogo a svg {
            max-width: 200px;
        }

        #SubMenu nav {
            height: 48px;
        }

        .SubMenuContainer .Container {
            padding: 0;
        }

        #OpenMenu {
            display: none;
        }

        ul.SubMenu {
            border: none;
            width: 100%;
            justify-content: space-between;
            padding: 12px 16px;
            display: flex;
            overflow-x: scroll;
            gap: 16px;
        }

        #SubMenu .Row.Boxed {
            padding-right: 0;
            padding-left: 0;
        }

        #SubMenu .BoxedLink {
            border: none;
            padding: 0;
        }

        .StoreListDropDown {
            top: 40px;
        }

        #menu_header {
            padding: 0;
        }
    }

    .CartButton {
        position: relative;
    }

    .CartButton.hideQuantity span {
        display: none;
    }

    .CartButton span {
        position: absolute;
        top: -9px;
        right: -5px;
        color: white;
        font-size: 8px;
        background-color: #c8012c;
        width: 12px;
        height: 12px;
        text-align: center;
        font-weight: bold;
        border-radius: 6px;
        line-height: 12px;
    }

    #TopBar {
        padding-left: 32px;
        padding-right: 32px;
    }

    @media screen  and (max-width: 920px) and (min-width: 720px) {
        #MainMenu .Logo svg {
            max-width: 162px;
            width: 100%;
        }

        #TopBar {
            padding-left: 16px;
            padding-right: 16px;
        }

        ul.Menu {
            gap: 12px;
        }

        .ShopContent a.HideOnMobile button {
            padding: 8px 12px;
            font-size: 14px;
        }

        ul.SubMenu li.BoxedLink {
            padding: 7px 12px;
        }
    }

    @media screen  and (max-width: 850px) and (min-width: 720px) {
        .ShopIcons {
            gap: 8px
        }

        .ShopContent {
            gap: 6px;
        }
    }

    .R-Custom-Modal-Content {
        max-width: 373px !important;
        width: 100% !important;
    }

    .stock-container {
        display: none;
        position: fixed; /* Tam ekran sabitle */
        top: 0;
        left: 0;
        width: 100%;
        height: 100vh;
        justify-content: center;
        align-items: center;
        background-color: rgba(0, 0, 0, 0.5);
        z-index: 9999;
    }

    .stock-form input[type="email"] {
        padding: 10px;
        margin-right: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        width: 100%;
    }

    .stock-form button {
        padding: 10px 15px;
        background: #007bff;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .stock-form button:hover {
        background: #0056b3;
    }

    .stock-form {
        background: #CD1B32;
        padding: 20px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .stock-form-wrapper {
        background: black;
        padding: 48px 20px;
        position: relative;
        margin: 24px;
    }


</style>




