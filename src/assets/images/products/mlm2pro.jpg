<script>
    document.addEventListener('DOMContentLoaded', () => {
        var playButton = document.querySelector('.video-play-button');
        var video = document.querySelector('.VideoControl');
        var videoIcon = document.querySelector('.video-play-button');
        var description = document.querySelector('.video-description');
        var image = document.querySelector('.ThumbImage');

        playButton.addEventListener('click', () => {
            if (video.paused) {
                image.style.display = "none";
                video.style.display = "block";
                video.play();
                videoIcon.setAttribute('src', 'https://cdn.shopify.com/s/files/1/0597/7853/1477/files/Type_Light_State_Pause.svg?v=1700825222');
                description.classList.add('Disable');
                videoIcon.style.display = "none";
                video.controls = true;
            } else {
                video.pause();
                description.classList.remove('Disable');
                videoIcon.setAttribute('src', 'https://cdn.shopify.com/s/files/1/0597/7853/1477/files/play_circle_e16f5735-f94c-49bf-8a41-bd247ebf48fc.svg?v=1700044029');
            }
            video.muted = false;
        });
    });

</script>



