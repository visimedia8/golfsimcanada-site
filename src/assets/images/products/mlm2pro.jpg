<script>
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(() => {
      let mm = gsap.matchMedia();
      mm.add("(max-width: 768px)", () => {
        let metricSection = gsap.timeline({
          scrollTrigger: {
            trigger: ".MlmProMetricSection",
            start: "top+=280 60%",
            end: "bottom 80%"
          }
        });

        metricSection.fromTo(".MlmProMetricSection", {opacity: 0}, {opacity: 1, duration: 1});
      });
      mm.add("(min-width: 769px)", () => {
        let metricSection = gsap.timeline({
          scrollTrigger: {
            trigger: ".MlmProMetricSection",
            start: "top 80%",
            end: "bottom 10%",
            scrub: true
          }
        });

        metricSection.fromTo(".MlmProMetricSection", {opacity: 0}, {opacity: 1, duration: 1});
      });
      
    }, 1000);
  });

</script>

<script>
   document.addEventListener('click', function (event) {
    const item = event.target.closest('.MlmProMetricIconItem');
    const items = document.querySelectorAll('.MlmProMetricIconItem');

    if (item) {
        // Prevent other scripts from running
        event.stopImmediatePropagation();
        const wasActive = item.classList.contains('Active');
        items.forEach(el => el.classList.remove('Active'));

        if (!wasActive) {
            item.classList.add('Active');
        }
        return;
    }
    items.forEach(el => el.classList.remove('Active'));
}, true); 
</script>



</div><div id="shopify-section-template--18801021714618__title_and_boxes_section_Y7ridq" class="shopify-section TitleBoxesSection"><style>
