<script>
    document.addEventListener('DOMContentLoaded', () => {
        let mm = gsap.matchMedia();
        let TitleBoxesWrapper = gsap.timeline({
            scrollTrigger: {
                trigger: ".TitleBoxesWrapper",
                start: "top 80%",
                end: "bottom",
                scrub: false,
                onLeave: () => {
                    ScrollTrigger.refresh();
                }
            }
        });
        mm.add("(min-width: 769px)", () => {
            TitleBoxesWrapper.fromTo('.TitleBoxesWrapperTitle', {opacity: 0}, {opacity: 1});
            TitleBoxesWrapper.fromTo('.TitleBoxesWrapperBox', {y: 100, opacity: 0}, {y: 0, opacity: 1});
        })
        mm.add("(max-width: 769px)", () => {
            TitleBoxesWrapper.fromTo('.TitleBoxesWrapperTitle', {opacity: 0}, {opacity: 1});
            TitleBoxesWrapper.fromTo('.TitleBoxesWrapperBox', {y: 20, opacity: 0}, {y: 0, opacity: 1, delay: -0.5});

            let HeroVideos = document.querySelectorAll('.HTVSectionVideoPlay');

            HeroVideos.forEach((node) => {
                node?.play();
            });

        })
    });
</script>

