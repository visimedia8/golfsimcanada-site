<script>


    document.addEventListener('DOMContentLoaded', () => {

     let iso_code = "SGD";

    const allLabels = Array.from(document.querySelectorAll(".radio-button-container"));

   /* allLabels.forEach(label => {
        const variantTitle = label.textContent.toLowerCase().trim();

        const isTitleist = variantTitle.includes("titleist");
        const isAud = iso_code === "AUD";
        const isEur = iso_code === "EUR";

        // AUD veya EUR ise Titleist gizle
        if (isTitleist && isAud ) {

            const radio = label.querySelector('input[type="radio"]');

            // Eğer kaldırılan Titleist zaten seçili ise → otomatik başka birini seç
            if (radio && radio.checked) {
                const firstAvailable = document.querySelector(
                    '.radio-button-container:not([data-hidden="true"]) input[type="radio"]'
                );

                if (firstAvailable) firstAvailable.checked = true;
            }

            // Remove etmeden önce gizlendi işareti
            label.setAttribute("data-hidden", "true");

            // DOM'dan kaldır
            label.remove();
        }
    });*/





        function updateVariantInURL(variantId) {
            const url = new URL(window.location);
            url.searchParams.set("variant", variantId);
            window.history.pushState({}, '', url);
            console.log("URL updated with variant:", url.toString());
        }

        function syncVariantToForm(variantId) {
            const formInputs = document.querySelectorAll('.form-id-input');
            formInputs.forEach(input => {
                input.value = variantId;
            });
        }


        const labels = document.querySelectorAll(".radio-button-container");
        const urlParams = new URLSearchParams(window.location.search);
        const variantFromURL = urlParams.get("variant");

        if (variantFromURL) {
            labels.forEach(label => {


                const variantId = label.getAttribute("data-variant-id");
                const input = label.querySelector('input[type="radio"]');

                if (variantId === variantFromURL) {
                    label.classList.add("active");
                    input.checked = true;
                    syncVariantToForm(variantId);
                } else {
                    label.classList.remove("active");
                    input.checked = false;
                }
            });
        } else {
            const activeLabel = document.querySelector(".radio-button-container");
            if (activeLabel) {
                activeLabel.classList.add("active");
                const input = activeLabel.querySelector('input[type="radio"]');
                if (input) input.checked = true;

                const variantId = activeLabel.getAttribute("data-variant-id");
                updateVariantInURL(variantId);
                syncVariantToForm(variantId);
            }
        }

        const formInputs = document.querySelectorAll('.form-id-input');

        labels.forEach(label => {

            label.addEventListener("click", () => {

                const variantId = label.getAttribute("data-variant-id");

                if (formInputs.length > 0) {
                    formInputs.forEach(input => {
                        input.value = variantId;
                    });
                }

                labels.forEach(l => {

                    l.classList.remove("active");
                    const input = l.querySelector('input[type="radio"]');
                    if (input) input.checked = false;
                });

                label.classList.add("active");
                const input = label.querySelector('input[type="radio"]');
                if (input) input.checked = true;

                //const variantId = label.getAttribute("data-variant-id");

                updateVariantInURL(variantId);
                syncVariantToForm(variantId);

            });
        });

        const checkboxes = document.querySelectorAll('.BuildYourBundleCheck');
        const stickyProductPriceElement = document.querySelector('.sticky-product-price');
        const addToCartFormBuildBundle = document.querySelector('.add-to-cart-form');
        const addToCartMobileFormBuildBundle = document.querySelector('.add-to-cart-form-mobile');
        const mobileAddToCartButton = document.querySelector('.add-to-bag-mobile');
        const stickyProductTitle = document.querySelector('.sticky-product-title');

        const currencyLocaleMap = {
            'EUR': 'nl-NL',
            'GBP': 'en-GB',
            'USD': 'en-US',
            'AUD': 'en-AU',
            'SGD': 'en-SG',
        };

        const currentCurrency = 'SGD';

        const currentLocale = currencyLocaleMap[currentCurrency] || 'en-US';

        if (checkboxes) {
            let basePrice = 0;
            let baseProductTitle = '';

            if (stickyProductPriceElement) {
                const basePriceData = stickyProductPriceElement.getAttribute('data-base-price');
                if (basePriceData) {
                    basePrice = parsePriceString(basePriceData);
                } else {
                    const priceText = stickyProductPriceElement.textContent || "0";
                    basePrice = parsePriceString(priceText);
                }
            }

            if (stickyProductTitle) {
                baseProductTitle = stickyProductTitle.textContent.trim();
            }

            function parsePriceString(priceStr) {
                // Remove currency symbols and spaces
                let cleanedPrice = priceStr.replace(/[^\d.,-]/g, '');

                // Count occurrences of commas and dots
                let commas = (cleanedPrice.match(/,/g) || []).length;
                let dots = (cleanedPrice.match(/\./g) || []).length;

                // Determine which is the decimal separator based on position
                let lastComma = cleanedPrice.lastIndexOf(',');
                let lastDot = cleanedPrice.lastIndexOf('.');

                // If both exist, the last one is the decimal separator
                if (commas > 0 && dots > 0) {
                    if (lastComma > lastDot) {
                        // Comma is decimal separator (e.g., European format: 1.234,56)
                        cleanedPrice = cleanedPrice.replace(/\./g, '').replace(',', '.');
                    } else {
                        // Dot is decimal separator (e.g., US/UK/AUD format: 1,234.56)
                        cleanedPrice = cleanedPrice.replace(/,/g, '');
                    }
                } else if (commas > 0) {
                    // Only commas - check if it's a decimal separator or thousands
                    // If comma is in the last 3 positions, it's likely a decimal separator
                    if (cleanedPrice.length - lastComma <= 3) {
                        cleanedPrice = cleanedPrice.replace(',', '.');
                    } else {
                        cleanedPrice = cleanedPrice.replace(/,/g, '');
                    }
                }
                // If only dots exist, keep them (they're decimal separators)

                return parseFloat(cleanedPrice) || 0;
            }

            function formatPrice(amount) {
                return new Intl.NumberFormat(currentLocale, {
                    style: 'currency',
                    currency: currentCurrency
                }).format(amount);
            }

            function updatePricesAndCart() {
                let bundleTotal = 0;
                let selectedItems = [];

                const existingInputs = addToCartFormBuildBundle.querySelectorAll('.ProProductInput');
                existingInputs.forEach(input => input.remove());

                let currentIndex = 1;

                checkboxes.forEach(function (checkbox) {
                    checkbox.addEventListener('change', function () {

                        const parentElement = this.closest('.BuildYourBundleItemContainer');

                        if (this.checked) {
                            parentElement.classList.add('active');
                        } else {
                            parentElement.classList.remove('active');
                        }
                    });
                    const item = checkbox.closest('.BuildYourBundleItem');
                    if (checkbox.checked && item) {
                        const isFree = item.getAttribute('data-product-free') === "true";
                        const priceStr = item.getAttribute('data-price') || "0";
                        const price = isFree ? 0 : parsePriceString(priceStr);

                        const quantityContainer = item.querySelector(".BuildItemQuantity");
                        const quantityValue = quantityContainer ? quantityContainer.querySelector(".QuantityValue") : null;
                        let quantity = quantityValue ? parseInt(quantityValue.textContent) || 1 : 1;

                        bundleTotal += price * quantity;

                        const productId = item.getAttribute('data-id');

                        let inputNode = document.createElement('input');
                        inputNode.setAttribute('type', 'hidden');
                        inputNode.setAttribute('name', `items[${currentIndex}][id]`);
                        inputNode.setAttribute('value', productId);
                        inputNode.setAttribute('class', 'ProProductInput');
                        addToCartFormBuildBundle.appendChild(inputNode);

                        let inputNodeQuantity = document.createElement('input');
                        inputNodeQuantity.setAttribute('type', 'hidden');
                        inputNodeQuantity.setAttribute('name', `items[${currentIndex}][quantity]`);
                        inputNodeQuantity.setAttribute('value', quantity);
                        inputNodeQuantity.setAttribute('class', 'ProProductInput');
                        addToCartFormBuildBundle.appendChild(inputNodeQuantity);

                        currentIndex++;
                        selectedItems.push({
                            title: item.getAttribute('data-product-title'),
                            price: price,
                            quantity: quantity
                        });
                    }
                });

                const totalPrice = basePrice + bundleTotal;

                if (stickyProductPriceElement) {
                    stickyProductPriceElement.textContent = formatPrice(totalPrice);
                }

                if (stickyProductTitle) {
                    let newTitle = baseProductTitle;

                    if (selectedItems.length > 0) {
                        const selectedProductTitles = selectedItems.map(item => `${item.title}`).join(' + ');
                        newTitle += ' + ' + selectedProductTitles;
                    }

                    stickyProductTitle.textContent = newTitle;
                }

                if (addToCartMobileFormBuildBundle) {
                    const mobileExistingInputs = addToCartMobileFormBuildBundle.querySelectorAll('.ProProductInput');
                    mobileExistingInputs.forEach(input => input.remove());

                    let mobileCurrentIndex = 1;

                    checkboxes.forEach(function (checkbox) {
                        const item = checkbox.closest('.BuildYourBundleItem');
                        if (checkbox.checked && item) {
                            const isFree = item.getAttribute('data-product-free') === "true";
                            const priceStr = item.getAttribute('data-price') || "0";
                            const price = isFree ? 0 : parsePriceString(priceStr);

                            const quantityContainer = item.querySelector(".BuildItemQuantity");
                            const quantityValue = quantityContainer ? quantityContainer.querySelector(".QuantityValue") : null;
                            let quantity = quantityValue ? parseInt(quantityValue.textContent) || 1 : 1;

                            const productId = item.getAttribute('data-id');

                            let inputNode = document.createElement('input');
                            inputNode.setAttribute('type', 'hidden');
                            inputNode.setAttribute('name', `items[${mobileCurrentIndex}][id]`);
                            inputNode.setAttribute('value', productId);
                            inputNode.setAttribute('class', 'ProProductInput');
                            addToCartMobileFormBuildBundle.appendChild(inputNode);

                            let inputNodeQuantity = document.createElement('input');
                            inputNodeQuantity.setAttribute('type', 'hidden');
                            inputNodeQuantity.setAttribute('name', `items[${mobileCurrentIndex}][quantity]`);
                            inputNodeQuantity.setAttribute('value', quantity);
                            inputNodeQuantity.setAttribute('class', 'ProProductInput');
                            addToCartMobileFormBuildBundle.appendChild(inputNodeQuantity);

                            mobileCurrentIndex++;
                        }
                    });
                }

                if (mobileAddToCartButton) {
                    const baseText = mobileAddToCartButton.getAttribute('data-base-text') || 'ADD TO CART - ';
                    mobileAddToCartButton.textContent = `${baseText}${formatPrice(totalPrice)}`;
                }
            }

            const quantityContainers = document.querySelectorAll(".BuildItemQuantity");

            quantityContainers.forEach(container => {
                const decreaseButton = container.querySelector(".QuantityButton#decrease");
                const increaseButton = container.querySelector(".QuantityButton#increase");
                const quantityValue = container.querySelector(".QuantityValue");
                const minusIcon = decreaseButton.querySelector("g");

                const checkbox = container.closest('.BuildYourBundleItem').querySelector('.BuildYourBundleCheck');

                let quantity = 0;

                decreaseButton.addEventListener("click", function () {
                    if (quantity > 0) {
                        quantity--;
                        quantityValue.textContent = quantity;

                        if (quantity === 0) {
                            decreaseButton.disabled = true;
                            minusIcon.setAttribute("opacity", "0.4");

                            checkbox.checked = false;
                            updatePricesAndCart();
                        }
                    }
                    updatePricesAndCart();
                });

                increaseButton.addEventListener("click", function () {
                    quantity++;
                    quantityValue.textContent = quantity;

                    if (quantity > 0) {
                        decreaseButton.disabled = false;
                        minusIcon.setAttribute("opacity", "1");

                        if (!checkbox.checked) {
                            checkbox.checked = true;
                            updatePricesAndCart();
                        }
                    }
                    updatePricesAndCart();
                });

                checkbox.addEventListener("change", function () {
                    if (checkbox.checked) {

                        if (quantity === 0) {
                            quantity = 1;
                            quantityValue.textContent = quantity;
                            decreaseButton.disabled = false;
                            minusIcon.setAttribute("opacity", "1");
                        }
                    } else {

                        quantity = 0;
                        quantityValue.textContent = quantity;
                        decreaseButton.disabled = true;
                        minusIcon.setAttribute("opacity", "0.4");
                    }
                    updatePricesAndCart();
                });
            });

            if (checkboxes.length > 0 && stickyProductPriceElement && addToCartFormBuildBundle) {
                updatePricesAndCart();

                checkboxes.forEach(function (checkbox) {
                    checkbox.addEventListener('change', updatePricesAndCart);
                });
            }
        }
    })


</script>

<style> #shopify-section-template--18801021714618__b7478dcc-bcb9-4fd4-8d83-73a9434c40b1 .BuildYourBundleTitle {font-weight: 500;} #shopify-section-template--18801021714618__b7478dcc-bcb9-4fd4-8d83-73a9434c40b1 .RightbarProductName {margin-bottom: 15px;} #shopify-section-template--18801021714618__b7478dcc-bcb9-4fd4-8d83-73a9434c40b1 .MembershipText {display: none;} </style></div><div id="shopify-section-template--18801021714618__e3c85366-92b7-420c-8ac8-f9bd8c2c6900" class="shopify-section ProductStickyAddToBag Disable"><style>
    .ProductStickyAddToBag {
        position: fixed;
        bottom: 0;
        left: 0;
        min-height: 64px;
        width: 100%;
        z-index: 999;
        background: #fff;
        overflow: hidden;
    }

    .ProductStickyAddToBagContainer {
        padding-left: 32px;
        border-top: 1px solid #DFDFDF;
    }

    .add-to-bag {
        background: #CD1B32;
        height: 100%;
        color: #FFF;
        font-family: Barlow;
        font-size: 14px;
        font-style: normal;
        font-weight: 600;
        line-height: 140%; /* 19.6px */
        letter-spacing: 0.98px;
        text-transform: uppercase;
        padding: 23px;
    }

    .sticky-product-title {
        font-size: 32px;
        text-align: left;
    }

    .sticky-product-desc {
        font-size: 12px;
        font-weight: 500;
        line-height: 150%;
    }

    .affirm-as-low-as {
        color: #000000;
        font-weight: 500;
    }

    .sticky-product-price {
        color: #252B37;
        font-size: 32px;
        font-style: italic;
        font-weight: 700;
        line-height: 90%; /* 28.8px */
        text-transform: uppercase;
    }

    .sticky-product-strike-price {
        color: #252B37;
        font-size: 18px;
        font-style: normal;
        font-weight: 500;
        line-height: 155%; /* 27.9px */
        letter-spacing: -0.18px;
        text-decoration: line-through;
    }

    @media screen  and (max-width: 720px) {
        .add-to-bag-mobile, .add-to-bag-mobile-refurb {
            background: #CD1B32;
            height: 100%;
            width: 100%;
            color: #FFF;
            font-family: Barlow;
            font-size: 14px;
            font-style: normal;
            font-weight: 600;
            line-height: 140%; /* 19.6px */
            letter-spacing: 0.98px;
            text-transform: uppercase;
            padding: 14px 0;
        }

        .ProductStickyAddToBagContainer {
            padding: 0;
        }

        .ProductStickyAddToBag {
            min-height: 46px;
        }
    }

    .sticky-image {
        max-width: 64px;
    }

    @keyframes fade-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    .FadeInAnimation {
        animation: fade-in 1s ease forwards;
    }

    .not-available {
        background-color: #CD1B32;
        color: #fff !important;
        height: 100%;
        padding: 23px;
        font-weight: 500;
        display: block;
    }

    .not-available-mobile {
        display: none;
    }

    @media screen and (max-width: 720px) {
        .not-available-mobile {
            max-width: 100%;
            width: 100%;
            background-color: #CD1B32;
            color: #fff !important;
            height: 100%;
            padding: 23px;
            font-weight: 500;
            display: block;
        }

        .not-available {
            display: none;
        }
    }

    

    
</style>




<div id="product-info"
     data-bundle-id=""
     data-bundle-title=""
     data-bundle-price="$780.99"
