<script>
    window.addEventListener("load", (event) => {
        const firstChild = document.querySelector('.SliderItemFirst').firstElementChild;
        firstChild.classList.add('Active');
    });
    document.addEventListener('DOMContentLoaded', () => {
        setTimeout(() => {
            let mobileSize = window.matchMedia("(max-width: 769px)");

            let sliderSection = gsap.timeline({
                scrollTrigger: {
                    trigger: ".VerticalTabSliderSection",
                    start: "top 80%",
                    end: "bottom 80%",
                    scrub: true
                }
            });

            sliderSection.fromTo(".VerticalTabSliderSection", {opacity: 0}, {opacity: 1, duration: 1});

            const slides = document.querySelectorAll(".slideItemF");
            const container = document.querySelector("#panelWrap");
            const panelWrap = document.getElementById("masterWrap");

            let dur = 0.5;
            let offsets = [];
            let oldSlide = 0;
            let activeSlide = 0;
            let navDots = [];
            let iw = 300;

            document.querySelector("#leftArrow").addEventListener("click", slideAnim);
            document.querySelector("#rightArrow").addEventListener("click", slideAnim);
            let newDot = document.querySelectorAll(".MlmProSliderSectionDotsItem");

            for (let i = 0; i < slides.length; i++) {
                newDot[i].index = i;
                newDot[i].addEventListener("click", slideAnim);
            }

            gsap.set(".arrow", {yPercent: -50});

            resizeIt();

            function slideAnim(e) {
                oldSlide = activeSlide;
                if (this.id === "dragger") {
                    activeSlide = offsets.indexOf(this.endX);
                } else {
                    if (gsap.isTweening(container)) {
                        return;
                    }
                    if (this.id === "leftArrow" || this.id === "rightArrow") {
                        activeSlide =
                            this.id === "rightArrow" ? (activeSlide += 1) : (activeSlide -= 1);
                        newDot.forEach(node => {
                            node.classList.remove('Active');
                        });
                        newDot[activeSlide].classList.add('Active');
                        if (activeSlide === 0) {
                            this.parentNode.querySelector('.leftArrow').classList.remove('Active');
                            this.parentNode.querySelector('.rightArrow').classList.add('Active');
                        } else if ((activeSlide + 1) === newDot.length) {
                            this.parentNode.querySelector('.rightArrow').classList.remove('Active');
                            this.parentNode.querySelector('.leftArrow').classList.add('Active');
                        } else {
                            this.parentNode.querySelector('.rightArrow').classList.add('Active');
                            this.parentNode.querySelector('.leftArrow').classList.add('Active');
                        }
                    } else if (this.className === "MlmProSliderSectionDotsItem") {
                        activeSlide = this.index;
                    } else {

                    }
                }

                activeSlide = activeSlide < 0 ? 0 : activeSlide;
                activeSlide = activeSlide > slides.length - 1 ? slides.length - 1 : activeSlide;
                if (oldSlide === activeSlide) {
                    return;
                }
                if (this.id != "dragger") {
                    gsap.to(container, dur, {x: offsets[activeSlide]});
                }
            }

            function resizeIt() {
                offsets = [];
                if (mobileSize.matches) {
                    iw = panelWrap.clientWidth;
                } else {
                    iw = panelWrap.clientWidth;
                }
                gsap.set("#panelWrap", {width: (slides.length * iw) + (32 * slides.length)});
                gsap.set(slides, {width: iw});
                for (let i = 0; i < slides.length; i++) {
                    offsets.push(-slides[i].offsetLeft);
                }
                gsap.set(container, {x: offsets[activeSlide]});
            }

            gsap.set(".hideMe", {opacity: 1});
            window.addEventListener("resize", resizeIt);

            if (document.querySelectorAll('.MlmProSliderSectionDotsItem').length > 0) {
                let sliderItems = document.querySelectorAll('.MlmProSliderSectionDotsItem');
                const sliderDotClick = (event) => {
                    let Slide = event.currentTarget;
                    let SlideIndex = Array.from(document.querySelectorAll('.MlmProSliderSectionDotsItem')).indexOf(Slide);
                    if (SlideIndex === 0) {
                        document.querySelector(".leftArrow").classList.remove('Active');
                        document.querySelector('.rightArrow').classList.add('Active');
                    } else if (SlideIndex === sliderItems.length - 1) {
                        document.querySelector(".rightArrow").classList.remove('Active');
                        document.querySelector('.leftArrow').classList.add('Active');
                    } else {
                        document.querySelector('.leftArrow').classList.add('Active');
                        document.querySelector('.rightArrow').classList.add('Active');
                    }
                    sliderItems.forEach((node, index) => {
                        node.classList.remove('Active');
                    });
                    Slide.classList.add('Active');
                };
                sliderItems.forEach(node => {
                    node.addEventListener('click', sliderDotClick);
                });
            }
        }, 1000);
    });
</script>

