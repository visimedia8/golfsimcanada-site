<script>
(function() {
    const fullPath = window.location.pathname + window.location.search;

    const baseSources = [
        "/collections/golf?filter.p.m.collection.categories=Golf%2BLaunch%2BMonitors&filter.p.m.device.compatibility=Android&filter.p.m.device.compatibility=Apple",
        "/collections/golf?filter.p.m.collection.categories=AnotherCategory&filter.p.m.device.compatibility=Android"
    ];

    // fullPath, baseSources dizisindeki herhangi bir string ile başlıyorsa
    const matched = baseSources.some(base => fullPath.startsWith(base));

    if (matched) {
        const target = "https://rapsodo.co.uk/collections/golf?filter.p.m.collection.categories=Golf%20Launch%20Monitors&filter.p.m.device.compatibility=Android&filter.p.m.device.compatibility=Apple";
        window.location.href = target;
    }
})();

</script>


    
