    /* label container */
    .radio-button-container {
        color: #000 !important;
        display: block;
        position: relative;
        padding: 14px 12px 14px 48px;
        border: #AFB2B8 1px solid;
        border-radius: 8px;
        margin-top: 16px;
        cursor: pointer;
        font-weight: 700 !important;
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
    }

    .radio-button-container:first-child {
        margin-top: 0;
    }

    .radio-button-container input {
        position: absolute;
        opacity: 0;
        cursor: pointer;
    }

    .checkmark {
        position: absolute;
        top: 22px;
        left: 12px;
        height: 24px;
        width: 24px;
        background-color: rgba(0, 0, 0, 0);
        border-radius: 50%;
        border: 1px solid rgba(0, 0, 0, 0.25);
    }

    .radio-button-container:hover input ~ .checkmark {
        border-color: rgba(0, 0, 0, 0.5);
    }

    .radio-button-container input:checked ~ .checkmark {
        background-color: rgba(0, 0, 0, 0);
        border-color: #CD1B32;
        border-width: 3px;
    }

    .checkmark:after {
        content: "";
        position: absolute;
        display: none;
        top: 10px;
        left: 10px;
        width: 1px;
        height: 1px;
    }

    .radio-button-container input:checked ~ .checkmark:after {
        display: block;
        top: 4px;
        left: 4px;
        width: 10px;
        height: 10px;
    }

    .radio-button-container .checkmark:after {
        border-radius: 50%;
        background: #CD1B32;
    }

    .radio-button-container.active {
        border: 1px solid #CD1B32;
    }

    .radio-button-container {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .variant-picker-image {
        max-width: 40px;
        height: auto;
    }
