    text-transform: capitalize;
    min-width: 97px;
  }
  .MlmProMetricIconMiddle{
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .MlmProMetricIconItem.IconLeft {
    align-items: flex-start;
  }
  .MlmProMetricIconItem.IconRight {
    align-items: flex-end;
  }
  .MlmProIconBox {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-width: 140px;
  }
  .MlmProMetricsImage {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
  }
  .MlmProMetricOrderThird .MlmProMetricIconItem.IconRight.Active .MlmProMetricInfoWrapper {
    left: unset;
    right: 34%;
  }
  .MlmProMetricOrderSecond .MlmProMetricIconItem.IconLeft.Active .MlmProMetricInfoWrapper {
    left: 34%;
    right: unset;
  }
  .MlmProMetricIconItem.IconLeft.Active .MlmProMetricInfoWrapper {
    left: unset;
    right: 100%;
  }
  .MetricIcon {
    font-family: 'Barlow', sans-serif;
    font-style: normal;
    font-weight: 500;
    font-size: 14px;
    line-height: 155%;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    position: relative;
  }
  .MetricIcon::after {
    content: "";
    background: url("https://cdn.shopify.com/s/files/1/0597/7853/1477/files/Measured_Badge.svg?v=1681469124");
    position: absolute;
    left: -30px;
    top: 3px;
    width: 17px;
    height: 17px;
  }
  .SubtractIcon {
    font-family: 'Barlow', sans-serif;
    font-style: normal;
    font-weight: 500;
    font-size: 14px;
    line-height: 155%;
    letter-spacing: -0.01em;
    color: #FFFFFF;
    padding-bottom: 21px;
    padding-top: 8px;
    position: relative;
  }
  .SubtractIcon::after {
    content: "";
    background: url("https://cdn.shopify.com/s/files/1/0597/7853/1477/files/Metric_Icon_f6ee7449-c4b9-4b11-af33-7be236bd854e.svg?v=1681469140");
    position: absolute;
    left: -30px;
    top: 11px;
    width: 17px;
    height: 17px;
  }
  .MlmProMetricSection {
      max-width: 1500px;
      margin: auto;
  }
  .BadgeText {
        border-radius: 20px;
        display: inline-block;
        padding: 2px 8px;
        font-weight: 600;
    }

    .NewBadgeText {
        background: #b7f8a5;
        margin-top: 12px;
    }

    .MeasuredBadgeText {
        border: #111 1px solid;
        margin-top: 12px;
    }

    .BgBlack .MeasuredBadgeText {
        border: #fff 1px solid;
    }

    .ComingSoonBadgeText {
        background: #ffdb5b;
        margin-top: 12px;
    }
    .MlmProMetricIconSide.WrapReverse {
        flex-wrap: wrap-reverse;
    }

    .BadgeGroup {
        display: flex;
        gap: 4px;
    }

    
  @media screen and (min-width: 770px) and (max-width: 1181px){
      .MlmProMetricSectionTitle {
          font-size: 96px;
          max-width: 650px;
      }
      .MlmProMetricSection {
          padding: 0 48px;
      }
      .MlmProMetricIconSide {
          width: 210px;
      }
      .MlmProMetricUi {
          max-width: 500px;
          width: 100%;
      }
      .TabMetricsWrapper{
        padding-top: 80px;
      }
  }
  @media screen and (max-width: 768px){
      .SubtractIcon {
          padding-top: 8px;
          padding-bottom: 24px;
      }
      .MlmProMetricIconSide {
          width: 100%;
          justify-content: center;
          align-items: center;
      }
      .MlmProMetricSection{
          padding:0px 24px 56px 24px;
      }
      .MlmProMetricSectionTitle{
          font-size:56px;
          line-height: 80%;
          margin-bottom: 48px;
          padding-bottom: 0px;
      }
      .MlmProMetricIconSide:first-child{
          margin-right: 0;
          flex-wrap: nowrap;
          height: auto;
      }
      .MlmProMetricWrapper{
          flex-wrap:wrap;
          justify-content: center;
          align-items: flex-start;
      }
      .MlmProMetricIconContentItem{
          justify-content: center;
      }
      .TabMetricsWrapper {
          padding-bottom: 0;
      }
      .MlmProMetricIconItem.IconRight {
          align-items: center;
          min-height: 200px;
      }
      .MlmProMetricIconItem{
          justify-content: flex-start;
          width: 50%;
          min-height: auto;
          padding-bottom: 8px;
          padding-top: 20px;
      }
      .MlmProMetricIconMiddle{
          order:1;
          width:100%;
      }
      .MlmProMetricOrderSecond{
          order:2;
          flex:1;
          flex-direction: column;
      }
      .MlmProMetricOrderThird{
          order:3;
          flex:1;
          flex-direction: column;
      }
      .MlmProMetricInfoWrapper {
          width: 210px;
          padding: 8px;
      }
      .MlmProMetricIconMiddle span{
          text-transform: none;
      }
      .MlmProMetricItemTitle{
        min-width: 100px;
      }
      .MlmProMetricIconItem.IconLeft{
        align-items: center;
          min-height: 200px;
      }
  }

  

  
</style>
