"$33:props:data:sections:0:row:4\",{\"title\":\"Side Total*\",\"description\":\"Deviation left or right of the target while the ball is in the air.\"},{\"title\":\"Angle of Descent*\",\"description\":\"The descent angle of the golf ball after reaching its peak trajectory.\"},{\"title\":\"Flight Time*\",\"description\":\"The total amount of time the golf ball is in the air.\"},{\"title\":\"Spin Axis*\",\"description\":\"The tilt angle of the golf ball's rotational axis after it leaves the clubface. This angle determines the curvature of the ball's flight. A positive spin axis results in a flight that curves right. A negative spin axis results in a flight that curves left.\"},{\"title\":\"Distance to Apex*\",\"description\":\"The distance covered by the ball in the air until it reaches the highest point of its trajectory.\"},{\"title\":\"Apex*\",\"description\":\"The peak height of the ball's trajectory.\"},{\"title\":\"Ball Flight Type*\",\"description\":\"Description of the balls initial start direction and shot shape.\"},{\"title\":\"Carry Distance*\",\"description\":\"Total distance the ball traveled in the air.\"},{\"title\":\"Run*\",\"description\":\"Distance the ball travels after making contact with the ground.\"},{\"title\":\"Total Distance*\",\"description\":\"Total distance the golf ball travels including the carry and run.\"}]},{\"title\":\"Club Data\",\"row\":[\"$33:props:data:sections:1:row:0\",\"$33:props:data:sections:1:row:1\",\"$33:props:data:sections:1:row:2\",\"$33:props:data:sections:1:row:3\"]}],\"sideNote\":\"*VIEW Software required to see these data points.\",\"disclaimer\":\"$undefined\"}}]]}]},{\"title\":\"What's Included\",\"description\":[[\"$\",\"p\",null,{\"className\":\"font-bold\",\"children\":\"Hardware\"}],\"$L55\",\"$L56\",\"$L57\",\"$L58\",\"$L59\",\"$L5a\",\"$L5b\",\"$L5c\",\"$L5d\",\"$L5e\",\"$L5f\",\"$L60\",\"$L61\",\"$L62\",\"$L63\",\"$L64\",\"$L65\",\"$L66\"]},{\"title\":\"Dimensions\",\"description\":\"$L67\"},{\"title\":\"Res