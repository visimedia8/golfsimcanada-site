ttom:0;color:transparent" src="https://cdn.shopify.com/s/files/1/0388/4423/5907/files/hf_20260629_190239_56d8f48a-cd02-4165-bf35-e1b9607c97e9.png?v=1783547379"/><img alt="" loading="lazy" decoding="async" data-nimg="fill" class="absolute top-0 left-0 object-contain 2xl:max-w-[65%] 2xl:ml-auto fade-out opacity-0 px-[24px] 2xl:pl-0 2xl:pr-[50px] transition-opacity duration-75 pointer-events-none" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="https://cdn.shopify.com/s/files/1/0388/4423/5907/files/hf_20260629_190202_53cf3fa0-9bd2-42c5-8488-9e8a09447850.png?v=1783547379"/></div><div class=" px-[24px] md:px-[50px] 2xl:pl-0 2xl:pr-[100px]"><div class="relative  max-w-[250px] md:max-w-[438px] 2xl:ml-auto"><div class="react-multi-carousel-list  " dir="ltr"><ul class="react-multi-carousel-track " style="transition:none;overflow:unset;transform:translate3d(0px,0,0)"></ul></div></div></div></div></div></div><div class="bg-yellow px-[32px] py-6.25 md:py-12.5 w-full flex flex-wrap gap-lg md:gap-xxl justify-center md:justify-evenly"><div class="flex items-center gap-sm text-md md:text-lg"><i class="fa-light fa-lg fa-headset"></i>Support available 7 days a week</div><div class="flex items-center gap-sm text-md md:text-lg"><i class="fa-light fa-lg fa-truck-fast"></i>Free shipping on launch monitors (continental U.S.)</div><div class="flex items-center gap-sm text-md md:text-lg"><i class="fa-light fa-lg fa-globe"></i>Trusted by golfers and facilities worldwide</div></div><div class=" w-full text-center p-[32px] px-5 md:p-[50px] lg:p-[100px] lg:pb-[50px]"><div class="mx-auto flex flex-col gap-md"><h1 class="text-black max-w-[600px]`">Features</h1></div></div><div class="pb-12.5"><div class="relative w-full h-full hidden md:block"><div class="react-multi-carousel-list pb-xl " dir="ltr"><ul class="react-multi-carousel-track " style="transition:none;overflow:unset;transform:translate3d(0px,0,0)"></ul></div></div></div><div class=" h-[32px] w-full bg-yellow"></div><div class=" flex flex-col lg:flex-row w-full h-fit max-w-[1440px] mx-auto"><div class="basis-1/2 relative aspect-756/606"><img alt="Dimple Optix®" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="/img/eye-mini/em-dimpleOptix-block-image.webp"/></div><div class=" py-[32px] px-lg lg:px-xxl basis-1/2 flex flex-col justify-center "><div class="flex flex-col gap-md lg:gap-xl"><div class="flex flex-col border-l-4 border-yellow pl-md"><h2 class="font-light">Dimple Optix®</h2><h2 class="font-light">Small Details, Big Insights</h2></div><div class="body-large max-w-[542px] font-normal">With our patented technology, Dimple Optix® lets you play with the ball you trust. Our advanced camera system captures the dimples of any golf ball at high frame rates giving you clear insights into your ball&#x27;s flight and spin.</div></div></div></div><div class="lg:flex-row-reverse flex flex-col lg:flex-row w-full h-fit max-w-[1440px] mx-auto"><div class="basis-1/2 relative aspect-756/606"><img alt="Club Optix®" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="/img/eye-mini/em-clubOptix-block-image.webp"/></div><div class="items-center py-[32px] px-lg lg:px-xxl basis-1/2 flex flex-col justify-center "><div class="flex flex-col gap-md lg:gap-xl"><div class="flex flex-col border-l-4 border-yellow pl-md"><h2 class="font-light">Club Optix®</h2><h2 class="font-light">See Your Impact</h2></div><div class="body-large max-w-[542px] font-normal">Experience every detail with Club Optix®—a powerful visual tool that provides instant feedback to help you understand exactly what happened during impact, delivering insights to elevate your performance.</div></div></div></div><div class=" flex flex-col lg:flex-row w-full h-fit max-w-[1440px] mx-auto"><div class="basis-1/2 relative aspect-756/606"><img alt="EYE MINI Data Points" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="/img/eye-mini/mini-data-image.webp"/></div><div class=" py-[32px] px-lg lg:px-xxl basis-1/2 flex flex-col justify-center "><div class="flex flex-col gap-md lg:gap-xl"><div class="flex flex-col border-l-4 border-yellow pl-md"><h2 class="font-light">19 Data Points</h2><h2 class="font-light"></h2></div><div class="body-large max-w-[542px] font-normal">Every data point that you need at your fingertips, not behind a paywall. Use actionable data to elevate your training. When paired with Performance Optix technology, it&#x27;s never been easier to define and expand your skill set anywhere you play.</div><button type="button" class="relative flex items-center justify-center rounded-lg text-center font-medium focus:outline-none focus:ring-4 !rounded-sm !px-lg !py-[12px] !font-bold group w-fit ring-0! outline-none! h-10 px-5 text-sm border border-charcoal disabled:border-lightGray/50 text-black hover:cursor-pointer undefined" role="button">View Data Points</button></div></div></div><div class=" h-[32px] w-full bg-yellow"></div><div class=" w-full text-center p-[32px] px-5 md:p-[50px] lg:p-[100px] lg:pb-[50px]"><div class="mx-auto flex flex-col gap-md"><h1 class="text-black max-w-[600px]`">VIEW Software</h1><p class="body-large max-w-[700px] mx-auto">Your Personal Driving Range</p></div></div><div class="pb-12.5"><div class="relative w-full h-full hidden md:block"><div class="react-multi-carousel-list pb-xl " dir="ltr"><ul class="react-multi-carousel-track " style="transition:none;overflow:unset;transform:translate3d(0px,0,0)"></ul></div></div></div><div class=" h-[32px] w-full bg-yellow"></div><div class=" w-full text-center p-[32px] px-5 md:p-[50px] lg:p-[100px] lg:pb-[50px]"><div class="mx-auto flex flex-col gap-md"><h1 class="text-black max-w-[600px]`">Unlock Advanced Tools for Peak Performance</h1><p class="body-large max-w-[700px] mx-auto">Take Your Game Further</p></div></div><div class=" flex flex-col lg:flex-row w-full h-fit max-w-[1440px] mx-auto"><div class="basis-1/2 relative aspect-756/606"><img alt="Third-Party Connector" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="/img/eye-xo2/gspro.webp"/></div><div class=" py-[32px] px-lg lg:px-xxl basis-1/2 flex flex-col justify-center "><div class="flex flex-col gap-md lg:gap-xl"><div class="flex flex-col border-l-4 border-yellow pl-md"><h2 class="font-light">Third-Party Connector</h2><h2 class="font-light"></h2></div><div class="py-1 px-[8px] bg-black text-white rounded-sm w-fit font-bold text-[12px] md:text-[16px]">Available with Ultimate Package or Standalone Subscription</div><div class="body-large max-w-[542px] font-normal">Expand your golf journey with Third Party Compatibility, making it easy to integrate with the popular platforms GSPro, E6 Connect, Creative Golf, ProTee Play and TGC 2019. Experience hundreds of meticulously designed courses, each ready for you to play without limits. This feature gives you the freedom to explore, practice, and connect with the world&#x27;s most renowned courses—all from your own setup.</div></div></div></div><div class="lg:flex-row-reverse flex flex-col lg:flex-row w-full h-fit max-w-[1440px] mx-auto"><div class="basis-1/2 relative aspect-756/606"><img alt="AI Trainer" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="/img/software/ai-trainer/ai_trainer_img.webp"/></div><div class="items-center py-[32px] px-lg lg:px-xxl basis-1/2 flex flex-col justify-center "><div class="flex flex-col gap-md lg:gap-xl"><div class="flex flex-col border-l-4 border-yellow pl-md"><h2 class="font-light">AI Trainer</h2><h2 class="font-light"></h2></div><div class="py-1 px-[8px] bg-black text-white rounded-sm w-fit font-bold text-[12px] md:text-[16px]">Available with Champion Package or Standalone Subscription</div><div class="body-large max-w-[542px] font-normal"><div>Your personal coach, powered by cutting-edge artificial intelligence to revolutionize your practice. It analyzes every detail of your swing in real time, providing tailored feedback and personalized recommendations to help you improve faster. With its dynamic learning system, the AI adapts to your unique game, offering smarter insights over time.</div><div class="pt-md italic">**Swing Optix® Cameras Required</div></div></div></div></div><div class=" flex flex-col lg:flex-row w-full h-fit max-w-[1440px] mx-auto"><div class="basis-1/2 relative aspect-756/606"><img alt="GAMEDAY" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="/img/software/gameday/gameday_card.webp"/></div><div class=" py-[32px] px-lg lg:px-xxl basis-1/2 flex flex-col justify-center "><div class="flex flex-col gap-md lg:gap-xl"><div class="flex flex-col border-l-4 border-yellow pl-md"><h2 class="font-light">GAMEDAY</h2><h2 class="font-light"></h2></div><div class="py-1 px-[8px] bg-black text-white rounded-sm w-fit font-bold text-[12px] md:text-[16px]">Available with Ultimate Package or Standalone Subscription</div><div class="body-large max-w-[542px] font-normal">GameDay takes your competitive spirit to a new level, offering a stunning selection of golf courses in vibrant 4K resolution. Choose from engaging game modes, explore premier practice facilities, or challenge friends for leaderboard spots. With GameDay, practice becomes thrilling, competition feels real, and every round brings the best of golf right into your space.</div></div></div></div><div class="lg:flex-row-reverse flex flex-col lg:flex-row w-full h-fit max-w-[1440px] mx-auto"><div class="basis-1/2 relative aspect-756/606"><img alt="Refine+" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="/img/software/refine/challenge-software.webp"/></div><div class="items-center py-[32px] px-lg lg:px-xxl basis-1/2 flex flex-col justify-center "><div class="flex flex-col gap-md lg:gap-xl"><div class="flex flex-col border-l-4 border-yellow pl-md"><h2 class="font-light">Refine/Refine+</h2><h2 class="font-light"></h2></div><div class="py-1 px-[8px] bg-black text-white rounded-sm w-fit font-bold text-[12px] md:text-[16px]">Available with Pro Package and Above</div><div class="body-large max-w-[542px] font-normal">Transform your space into a luxury golf retreat with REFINE and REFINE+. Engage in precision-driven short game drills, play on beautifully rendered courses, and enjoy a personal golf experience without leaving home. For golfers who crave variety, REFINE+ expands access to an impressive collection of world-class courses.</div></div></div></div><div class=" h-[32px] w-full bg-yellow"></div><div class="relative flex flex-col items-center pb-[64px]"><div id="software-packages" class="w-full h-[0.1px] pointer-events-none absolute -top-12.5 left-0"></div><div class=" w-full text-center p-[32px] px-5 md:p-[50px] lg:p-[100px] lg:pb-[50px]"><div class="mx-auto flex flex-col gap-md"><h1 class="text-black max-w-[600px]`">Uneekor Subscriptions</h1><p class="body-large max-w-[700px] mx-auto">Your Game, Your Way—Uneekor Packages Built for You</p></div></div><div class="w-full px-5 md:px-[50px] lg:px-[100px]"><div class="max-w-screen w-full overflow-x-scroll x-scrollbox scrollbar-hide flex 2xl:justify-center"><div class="flex gap-md md:gap-lg"><div class="border-[0.5px] p-lg md:p-xl min-w-[280px] max-w-[280px] md:min-w-[290px] md:max-w-[290px] h-full rounded-md fle