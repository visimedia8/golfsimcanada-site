t/static/chunks/19f9228acf7e5cc6.js\",\"/_next/static/chunks/485e33192d0f4ac6.js\",\"/_next/static/chunks/22b267202ecebdd7.js\",\"/_next/static/chunks/87461371c039629f.js\",\"/_next/static/chunks/ed85ddad4bebcede.js\",\"/_next/static/chunks/1e32de8a5cd8a1da.js\",\"/_next/static/chunks/dc6cd406b47778c7.js\",\"/_next/static/chunks/adcace807a130329.js\"],\"default\"]\n4b:I[23885,[\"/_next/static/chunks/8bf40e435c599db2.js\",\"/_next/static/chunks/3172375a920840c6.js\",\"/_next/static/chunks/c4ef70eba3fb7788.js\",\"/_next/static/chunks/87bb1830467dc122.js\",\"/_next/static/chunks/daf0290953cb136c.js\",\"/_next/static/chunks/19f9228acf7e5cc6.js\",\"/_next/static/chunks/485e33192d0f4ac6.js\",\"/_next/static/chunks/22b267202ecebdd7.js\",\"/_next/static/chunks/87461371c039629f.js\",\"/_next/static/chunks/ed85ddad4bebcede.js\",\"/_next/static/chunks/1e32de8a5cd8a1da.js\",\"/_next/static/chunks/dc6cd406b47778c7.js\",\"/_next/static/chunks/adcace807a130329.js\"],\"default\"]\n30:[\"$\",\"h2\",null,{\"className\":\"font-light\",\"children\":\"19 Data Points\"}]\n31:[\"$\",\"h2\",null,{\"className\":\"font-light\",\"children\":\"$undefined\"}]\n32:[\"$\",\"div\",null,{\"className\":\"body-large max-w-[542px] font-normal\",\"children\":\"Every data point that you need at your fingertips, not behind a paywall. Use actionable data to elevate your training. When paired with Performance Optix technology, it's never been easier to define and expand your skill set anywhere you play.\"}]\n"])</script><script>self.__next_f.push([1,"33:[\"$\",\"$L48\",null,{\"data\":{\"sections\":[{\"title\":\"Ball Data\",\"row\":[{\"title\":\"Ball Speed\",\"description\":\"Velocity at which the ball is traveling when it leaves the club face after impact.\"},{\"title\":\"Side Spin\",\"description\":\"Horizontal spin measurement affecting golf ball movement left or right in flight.\"},{\"title\":\"Back Spin\",\"description\":\"The amount of spin on the golf ball immediately after impact, measured in revolutions per minute (RPM). It plays a crucial role in determining the height, distance, and control of a shot by influencing the ball's lift and trajectory through the air.\"},{\"title\":\"Side Angle\",\"description\":\"Angle at which the ball starts its flight, relative to a straight target line (Horizontal launch angle).\"},{\"title\":\"Launch Angle\",\"description\":\"The initial vertical launch angle of the golf ball post-clubface impact (relative to the ground).\"},{\"title\":\"Side Total*\",\"description\":\"Deviation left or right of the target while the ball is in the air.\"},{\"title\":\"Angle of Descent*\",\"description\":\"The descent angle of the golf ball after reaching its peak trajectory.\"},{\"title\":\"Flight Time*\",\"description\":\"The total amount of time the golf ball is in the air.\"},{\"title\":\"Spin Axis*\",\"description\":\"The tilt angle of the golf ball's rotational axis after it leaves the clubface. This angle determines the curvature of the ball's flight. A positive spin axis results in a flight that curves right. A negative spin axis results in a flight that curves left.\"},{\"title\":\"Distance to Apex*\",\"description\":\"The distance covered by the ball in the air until it reaches the highest point of its trajectory.\"},{\"title\":\"Apex*\",\"description\":\"The peak height of the ball's trajectory.\"},{\"title\":\"Ball Flight Type*\",\"description\":\"Description of the balls initial start direction and shot shape.\"},{\"title\":\"Carry Distance*\",\"description\":\"Total distance the ball traveled in the air.\"},{\"title\":\"Run*\",\"description\":\"Distance the ball travels after making contact with the ground.\"},{\"title\":\"Total Distance*\",\"description\":\"Total distance the golf ball travels including the carry and run.\"}]},{\"title\":\"Club Data\",\"row\":[{\"title\":\"Club Speed\",\"description\":\"The speed of the club at impact.\"},{\"title\":\"Smash Factor\",\"description\":\"Quantifies the efficiency of impact between the club face and the golf ball. It is calculated by dividing the speed of the ball by the speed of the club head at impact. A higher smash factor indicates a more efficient transfer of energy from the club to the ball, typically resulting in greater distance and accuracy.\"},{\"title\":\"Club Path\",\"description\":\"The in to out, or out to in movement of the club head's geometric center at the center at the time of impact. Club Path is the direction (right or left) the club head is moving at impact and is measured relative to the target line.\"},{\"title\":\"Attack Angle\",\"description\":\"A negative attack angle means the clubhead is descending into the ball, while a positive angle indicates the clubhead is ascending or sweeping upwards.\"}]}],\"sideNote\":\"*VIEW Software required to see these data points.\",\"disclaimer\":\"$undefined\"}}]\n"])</script><script>self.__next_f.push([1,"34:[\"$\",\"div\",null,{\"className\":\" h-[32px] w-full bg-yellow\"}]\n35:[\"$\",\"div\",null,{\"className\":\" w-full text-center p-[32px] px-5 md:p-[50px] lg:p-[100px] lg:pb-[50px]\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto flex flex-col gap-md\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-black max-w-[600px]`\",\"children\":\"VIEW Software\"}],[\"$\",\"p\",null,{\"className\":\"body-large max-w-[700px] mx-auto\",\"children\":\"Your Personal Driving Range\"}]]}]}]\n"])</script><script>self.__next_f.push([1,"36:[\"$\",\"div\",null,{\"className\":\"pb-12.5\",\"children\":[\"$\",\"$L2e\",null,{\"slides\":[{\"media\":{\"src\":\"/img/software/view/view_display.webp\",\"alt\":\"VIEW Software\"},\"title\":\"Driving Range Freedom\",\"description\":\"Hit as many shots as you want, whenever you want—no restrictions, no limits. Watch your ball flight in stunning detail, track every shot, and focus on the numbers that matter most. Whether you’re perfecting your swing or just hitting leisurely, VIEW gives you that luxury.\"},{\"media\":{\"src\":\"/img/software/a