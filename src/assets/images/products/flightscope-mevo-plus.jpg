      console.debug("shogun: Optimization is disabled, skipping optimizer initialization");
      return;
    }

    // Load shop metafield configuration
    
    const shopMetafieldConfig = {"default_theme_id":129080131716,"method":"greedy","optimizations":[],"expires_at":1785471304000,"env":"production"};
    
