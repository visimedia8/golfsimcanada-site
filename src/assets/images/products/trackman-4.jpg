"0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25"></path></svg></a></div><div style="opacity:0;transform:translateY(5px)"><a href="https://trackmanuniversity.com/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-1 text-tm-c-light font-bold text-base 3xl:text-lg transition-opacity duration-300 hover:opacity-40">Trackman University<svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-3.5 h-3.5"><path stroke-linecap="round" stroke-linejoin="round" d="m4.5 19.5 15-15m0 0H8.25m11.25 0v11.25"></path></svg></a></div></nav></div></div><div class="w-full md:w-auto flex flex-wrap xl:flex-nowrap xl:flex-1 items-start xl:justify-end 4xl:items-stretch gap-5"></div></div></div></div></div></div></div></header><main><section class="grid relative bg-tm-c-dark h-[100vh]" aria-labelledby="primary-hero-title"><div class="pointer-events-none absolute inset-0 z-[1] bg-[linear-gradient(180deg,rgba(9,9,9,0)_27.4%,rgba(9,9,9,0.7)_70.1%,rgba(9,9,9,0.95)_100%)]"></div><div class="relative row-start-1 col-start-1 w-full z-[1] p-5 sm:p-10 md:p-12 lg:p-14 xl:p-24 2xl:p-28 h-screen"><div class="grid-container text-tm-c-light h-full content-end xl:pb-5"><div class="text-center md:text-left
