                  .arrow { animation: wave 2.5s ease-in-out infinite; }
                  .a1 { animation-delay: 0s; }
                  .a2 { animation-delay: 0.33s; }
                  .a3 { animation-delay: 0.67s; }
                </style><polyline class="arrow a1" points="8 1 12 5 16 1" fill="none" stroke="white" stroke-width="1" stroke-linejoin="miter"></polyline><polyline class="arrow a2" points="8 6 12 10 16 6" fill="none" stroke="white" stroke-width="1" stroke-linejoin="miter"></polyline><polyline class="arrow a3" points="8 11 12 15 16 11" fill="none" stroke="white" stroke-width="1" stroke-linejoin="miter"></polyline></svg></div></div></section><section class="grid relative bg-tm-c-dark h-[100vh] md:h-[100vh]"><img alt="Golfer swings in an indoor simulator, displaying a virtual golf course on a large screen with lush greenery and a blue sky." fetchPriority="auto" loading="lazy" decoding="async" data-nimg="fill" class="row-start-1 col-start-1 object-cover block md:hidden" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="(max-width: 768px) 100vw, 0" srcSet="/_next/image?url=https%3A%2F%2Fa.storyblok.com%2Ff%2F117513%2F786x1704%2Fea75e96030%2Fwhy-accuracy-matters_mobile.webp&amp;w=640&amp;q=100 640w, /_next/image?url=https%3A%2F%2Fa.storyblok.com%2Ff%2F117513%2F786x1704%2Fea75e96030%2Fwhy-accuracy-matters_mobile.webp&amp;w=750&amp;q=100 750w, /_next/image?url=https%3A%2F%2Fa.storyblok.com%2Ff%2F117513%2F786x1704%2Fea75e96030%2Fwhy-accuracy-matters_mobile.webp&amp;w=828&amp;q=100 828w, /_next/image?url=https%3A%2F%2Fa.storyblok.com%2Ff%2F117513%2F786x1704%2Fea75e96030%2Fwhy-accuracy-matters_mobile.webp&amp;w=1080&amp;q=100 1080w, /_next/image?url=https%3A%2F%2Fa.storyblok.com%2Ff%2F117513%2F786x1704%2Fea75e96030%2Fwhy-accuracy-matters_mobile.webp&amp;w=1200&amp;q=100 1200w, /_next/image?url=https%3A%2F%2Fa.storyblok.com%2Ff%2F117513%2F786x1704%2Fea75e96030%2Fwhy-accuracy-matters_mobile.webp&amp;w=1920&amp;q=100 1920w, /_next/image?url=https%3A%2F%2Fa.storyblok.com%2Ff%2F117513%2F786x1704%2Fea75e96030%2Fwhy-accuracy-matters_mobile.webp&amp;w=2048&amp;q=100 2048w, /_next/image?url=https%3A%2F%2Fa.storyblok.com%2Ff%2F117513%