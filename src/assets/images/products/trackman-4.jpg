  "about": {
    "@type": [
      "Product",
      "FAQPage"
    ],
    "name": "Trackman Golf Simulator",
    "description": "The world's most accurate indoor golf simulator. Combines dual radar and camera tracking technology used by the PGA Tour, DP World Tour, LPGA Tour, and LIV Golf. Includes Virtual Golf 3 software with 500+ world-class courses and 40+ data parameters. Available for home and commercial use.",
    "url": "https://www.trackman.com/golf/simulator",
