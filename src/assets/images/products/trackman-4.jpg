eft [\u0026_h1]:drop-shadow-2xl [\u0026_h2]:drop-shadow-2xl [\u0026_p]:drop-shadow-2xl col-start-1 col-span-4 md:ml-5 md:col-start-5 md:col-span-4 lg:ml-0 lg:col-start-10 lg:col-span-5 xl:col-start-18 xl:col-span-9 row-start-2 md:row-start-1\",\"children\":[\"$undefined\",[[\"$\",\"h2\",\"0\",{\"className\":\"mb-6 [\u0026\u003eu]:no-underline [\u0026\u003eu]:text-tm-c-primary\",\"children\":[\"Find a golf simulator near you\"]}],[\"$\",\"p\",\"1\",{\"className\":\"font-medium text-base lg:text-lg mb-5 last-of-type:mb-0 [\u0026\u003eu]:no-underline [\u0026\u003eu]:text-tm-c-primary\",\"children\":[\"Want to see a Trackman golf simulator in action? Use the Locator find and book a tee time today.\"]}]],[\"$\",\"div\",null,{\"className\":\"flex flex-wrap gap-5 mt-6 flex-row items-center justify-center md:justify-start\",\"children\":[[\"$\",\"$L13\",\"2cd226c6-e0c0-4a05-a48d-e84c485fc10e\",{\"href\":\"/locator\",\"target\":\"_self\",\"rel\":\"$undefined\",\"children\":\"Go to Locator\",\"className\":\"inline-flex cursor-pointer items-center justify-center whitespace-nowrap rounded-md font-medium text-base xl:text-lg ring-offset-white transition-all duration-300 focus-visible:outline-hidden disabled:cursor-not-allowed disabled:pointer-events-none disabled:opacity-50 dark:ring-offset-neutral-950 text-tm-c-light border-2 border-tm-c-primary w-fit text-center bg-tm-c-primary py-2 px-6 hover:bg-[#ab490e] hover:border-[#ab490e]\",\"style\":\"$undefined\",\"ref\":null}]]}]]}]]}]}]\n"])</script><script>self.__next_f.push([1,"33:[\"$\",\"$L37\",\"354a8c78-1c3e-4993-a55f-b59c7feea89d\",{\"ref\":\"$undefined\",\"blok\":{\"_uid\":\"354a8c78-1c3e-4993-a55f-b59c7feea89d\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2,\"textAlign\":null},\"content\":[{\"text\":\"FAQ\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null}}]},\"heading\":[],\"padding\":[{\"top\":\"none\",\"_uid\":\"80b04bdf-b715-421f-87e4-d87142b49d57\",\"bottom\":\"xl\",\"component\":\"padding\"}],\"component\":\"accordion\",\"dark_theme\":true,\"accordion_items\":[{\"_uid\":\"f6805e4f-955b-45ce-a341-2adb84c275d8\",\"title\":\"How much is a golf simulator?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The cost of a Trackman golf simulator depends on your space, setup, and software package. Whether it’s for your home or a commercial facility, we’ll help you build a solution that fits your needs — just reach out for a tailored quote.\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"a9460c01-dd35-4c6b-86a6-ed09d460b81a\",\"title\":\"How much space do I need for a golf simulator?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"For the best experience, we recommend a room that’s at least 15 ft wide, 10 ft high, and 18 ft deep (approximately 4.6m x 3.1m x 5.5m). The absolute minimum space required is around 8 ft 2 in (2.5m) from screen to ball — but actual width and height depend on your swing comfort.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"For a full breakdown by room type and launch monitor, see our \",\"type\":\"text\"},{\"text\":\"golf simulator space guide\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/blog/golf/how-much-room-for-a-golf-simulator\",\"uuid\":\"703a2b1c-8d85-43dc-883c-a767e4258d33\",\"anchor\":null,\"target\":\"_self\",\"linktype\":\"story\"}}]},{\"text\":\".\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"c5993695-7cb8-4973-b14c-52c244b18234\",\"title\":\"How tall does the ceiling need to be for a golf simulator?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Ceiling height depends on your swing and body height. To comfortably swing a driver, most users need at least 9 to 10 feet (2.7–3.1 m). Taller players or those with aggressive swings may require more space to avoid feeling restricted.\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"2f06e394-8f33-4ede-a9cb-b41f67a50dfa\",\"title\":\"How does a Trackman golf simulator work?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"Trackman combines the best of both worlds — radar and camera tracking — to measure club and ball data with incredible precision. Paired with our Virtual Golf 3 software, it creates an ultra-realistic indoor golf experience that looks and feels just like the real thing.\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"f6557daf-19bd-4551-b8e5-2afa45033135\",\"title\":\"Can I use a Trackman golf simulator at home?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Yes, the Trackman iO Home is purpose-built for home use. It offers the same trusted accuracy and immersive software experience as our professional setups - without requiring a large space. Whether you're building a dedicated simulator room, garage project or garden house, Trackman iO makes it possible.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"See how others have built theirs in our \",\"type\":\"text\"},{\"text\":\"garage golf simulator guide\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/blog/golf/garage-golf-simulator\",\"uuid\":\"a377c401-37ba-4da8-a46c-05fac9fc4c7c\",\"anchor\":null,\"target\":\"_self\",\"linktype\":\"story\"}},{\"type\":\"underline\"}]},{\"text\":\".\",\"type\":\"text\",\"marks\":[{\"type\":\"underline\"}]}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"a93786d9-f8e2-4e0c-8edb-f4daf5443613\",\"title\":\"What does a home golf simulator include?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"A home golf simulator from Trackman is a complete, ready-to-play package — not just a screen and a mat. It combines our tour-proven radar and camera launch monitor (the same technology used on the PGA Tour), Virtual Golf 3 software with 500+ world-class courses, and a custom-built enclosure designed to fit your space. Every component is engineered to work together, so what you see on screen matches exactly what happens at impact. Complete packages start from USD 29,715 and can be configured for a dedicated golf room, garage, or basement.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Explore the Trackman home golf simulator packages\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/golf/solutions/home-golf-simulator\",\"uuid\":\"313fa89a-fdea-44d2-bd3a-abb51190b1f6\",\"anchor\":null,\"target\":\"_self\",\"linktype\":\"story\"}},{\"type\":\"underline\"}]}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"30b29398-6c82-4bb3-9f58-e4f431641682\",\"title\":\"What is the best golf simulator for home use?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"content\":[{\"text\":\"The Trackman iO Home is built specifically for golfers who want a simulator in their home. It combines our trusted radar and camera technology with ultra-realistic graphics and access to over 300 world-class courses. It’s easy to install, space-efficient, and delivers the same pro-level experience we’re known for — right in your own home.\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"8551f61c-d87a-4731-881c-565ebe7bbc5d\",\"title\":\"What golf simulator do tour pros use?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Every major professional golf organization — including the PGA Tour, DP World Tour, LPGA Tour and LIV Golf — independently chose Trackman as their official measurement technology. The same radar technology powering those tours powers every Trackman simulator.\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"26516b55-c9fd-43e3-8a6c-c0d1264373d1\",\"title\":\"How accurate is a home golf simulator?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Accuracy depends entirely on the technology measuring your shots. Most simulators only track initial launch conditions and model the rest. Trackman combines radar and camera technology, with models built on billions of measured full ball flights — meaning what you see on screen matches what happens on the course.\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"7f06e38e-d709-4a1e-815f-3eb51b3121a0\",\"title\":\"What is the difference between Trackman and other golf simulators?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Most simulators use either camera or radar technology and estimate what they can't measure. Trackman combines both, using the best of each. And unlike competitors that only track initial launch conditions, Trackman's models are built on billions of measured full ball flights — delivering real data, not estimates.\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"92784e9e-1166-4d2c-a2ad-d60421d9cdab\",\"title\":\"Is a Trackman simulator worth it?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"If practice is the goal, accuracy matters. A simulator that shows you the wrong carry distance or spin rate reinforces the wrong habits. Trackman is the only simulator built on the same measurement technology trusted by every major tour and equipment manufacturer — so the feedback you get indoors translates directly to the course.\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"},{\"_uid\":\"5b58be3b-36d5-4244-9484-0cb17245d525\",\"title\":\"What is the most accurate golf simulator?\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Trackman is the only golf simulator combining radar and camera technology with models built on billions of measured real ball flights. It is the same technology independently chosen by the PGA Tour, DP World Tour, LPGA Tour, LIV Golf and the R\u0026A — making it the most validated measurement system in golf.\",\"type\":\"text\"}]}]},\"component\":\"accordion_item\"}]}}]\n"])</script><script>self.__next_f.push([1,"39:Ta9d,"])</script><script>self.__next_f.push([1,"Afghanistan,Åland Islands,Albania,Algeria,American Samoa,Andorra,Angola,Anguilla,Antigua and Barbuda,Argentina,Armenia,Aruba,Australia,Austria,Azerbaijan,Bahamas,Bahrain,Bangladesh,Barbados,Belarus,Belgium,Belize,Benin,Bermuda,Bhutan,Bolivarian Republic of Venezuela,Bolivia,Bonaire,Sint Eustatius and Saba,Bosnia and Herzegovina,Botswana,Brazil,British Indian Ocean Territory,British Virgin Islands,Brunei Darussalam,Bulgaria,Burkina Faso,Burundi,Cabo Verde,Cambodia,Cameroon,Canada,Caribbean,Cayman Islands,Central African Republic,Chad,Chile,Christmas Island,Cocos (Keeling) Islands,Colombia,Comoros,Congo,Congo (DRC),Cook Islands,Costa Rica,Côte d’Ivoire,Croatia,Cuba,Curaçao,Cyprus,Czech Republic,Denmark,Djibouti,Dominica,Dominican Republic,Ecuador,Egypt,El Salvador,Equatorial Guinea,Eritrea,Estonia,Ethiopia,Europe,Falkland Islands,Faroe Islands,Fiji,Finland,France,French Guiana,French Polynesia,Gabon,Gambia,Georgia,Germany,Ghana,Gibraltar,Greece,Greenland,Grenada,Guadeloupe,Guam,Guatemala,Guernsey,Guinea,Guinea-Bissau,Guyana,Haiti,Honduras,Hong Kong S.A.R.,Hungary,Iceland,India,Indonesia,Iran,Iraq,Ireland,Islamic Republic of Pakistan,Isle of Man,Israel,Italy,Jamaica,Japan,Jersey,Jordan,Kazakhstan,Kenya,Kiribati,Korea,Kosovo,Kuwait,Kyrgyzstan,Lao P.D.R.,Latin America,Latvia,Lebanon,Lesotho,Liberia,Libya,L