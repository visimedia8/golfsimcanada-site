\"id\":\"region\",\"_uid\":\"326cd998-f8a7-4cb2-bd7a-1d37c1f667a4\",\"value\":\"Region is required\",\"component\":\"ui_text\"},{\"id\":\"message\",\"_uid\":\"f17a8edb-1a83-4ff2-829d-011595f754b7\",\"value\":\"Message is required\",\"component\":\"ui_text\"}]},\"slug\":\"contact-form\",\"full_slug\":\"global/contact-form\",\"sort_by_date\":null,\"position\":0,\"tag_list\":[],\"is_startpage\":false,\"parent_id\":66403853,\"meta_data\":null,\"group_id\":\"4ce6d278-046f-46b7-8435-eb7fce445c28\",\"first_published_at\":\"2021-08-16T08:43:21.986Z\",\"release_id\":null,\"lang\":\"default\",\"path\":null,\"alternates\":[],\"default_full_slug\":\"global/contact-form\",\"translated_slugs\":[{\"path\":\"global/contact-form\",\"name\":null,\"lang\":\"zh-cn\",\"published\":null},{\"path\":\"global/contact-form\",\"name\":null,\"lang\":\"ko\",\"published\":null},{\"path\":\"global/contact-form\",\"name\":null,\"lang\":\"it\",\"published\":null},{\"path\":\"global/contact-form\",\"name\":null,\"lang\":\"es\",\"published\":null},{\"path\":\"global/contact-form\",\"name\":null,\"lang\":\"fr\",\"published\":null},{\"path\":\"global/contact-form\",\"name\":null,\"lang\":\"de\",\"published\":null},{\"path\":\"global/contact-form\",\"name\":null,\"lang\":\"ja\",\"published\":null}],\"_stopResolving\":true},\"is_franchise_form\":false,\"rich_text_content\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2,\"textAlign\":null},\"content\":[{\"text\":\"LET’S CONNECT\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Tell us a little about yourself and the project you have in mind. We’ll connect you with a Trackman expert who can share more about our solutions and answer any questions you have.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Simulator solutions start at USD 29,715 incl. shipping\",\"type\":\"text\",\"marks\":[{\"type\":\"bold\"}]}]}]}},\"$33:props:blok\"],\"icon\":\"\",\"theme\":\"light\",\"schema\":\"$3b\",\"no_index\":false,\"component\":\"page\",\"is_featured\":false,\"show_search\":false,\"is_japan_only\":false,\"primary_color\":{\"_uid\":\"1ed638ab-16d0-4ff6-8b5e-b4f1f6e4f050\",\"color\":\"#f40000\",\"plugin\":\"native-color-picker\"},\"featured_image\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"featured_title\":\"\",\"featured_subtitle\":\"\"},\"slug\":\"simulator\",\"full_slug\":\"golf/simulator/\",\"sort_by_date\":null,\"position\":-30,\"tag_list\":[],\"is_startpage\":true,\"parent_id\":344462942,\"meta_data\":null,\"group_id\":\"1cd8399a-cf43-4d9f-9e83-9589245240c2\",\"first_published_at\":\"2023-09-19T07:06:03.262Z\",\"release_id\":null,\"lang\":\"default\",\"path\":null,\"alternates\":[],\"default_full_slug\":\"golf/simulator/\",\"translated_slugs\":[{\"path\":\"golf/simulator/\",\"name\":null,\"lang\":\"zh-cn\",\"published\":true},{\"path\":\"golf/simulator/\",\"name\":null,\"lang\":\"ko\",\"published\":true},{\"path\":\"golf/simulator/\",\"name\":null,\"lang\":\"it\",\"published\":true},{\"path\":\"golf/simulator/\",\"name\":null,\"lang\":\"es\",\"published\":true},{\"path\":\"golf/simulator/\",\"name\":null,\"lang\":\"fr\",\"published\":true},{\"path\":\"golf/simulator/\",\"name\":null,\"lang\":\"de\",\"published\":true},{\"path\":\"golf/simulator/\",\"name\":null,\"lang\":\"ja\",\"published\":true}]},\"bridgeOptions\":{\"resolveRelations\":[\"contact_form.form_reference\"]}}]\n"])</script><script>self.__next_f.push([1,"3c:T3133,"])</script><script>self.__next_f.push([1,"{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"WebPage\",\n  \"name\": \"Trackman Golf Simulator | Most Accurate Indoor Simulator\",\n  \"description\": \"The world's most accurate indoor golf simulator. Tour-proven dual radar and camera technology, Virtual Golf 3, and 500+ courses. Complete simulator packages from USD 29,715. Available for home and commercial use.\",\n  \"url\": \"https://www.trackman.com/golf/simulator\",\n  \"image\": \"https://a.storyblok.com/f/117513/1200x630/5cecb7dc8f/trackman_golf_simulator.jpg\",\n  \"inLanguage\": \"en\",\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Trackman\",\n    \"url\": \"https://www.trackman.com\",\n    \"logo\": {\n      \"@type\": \"ImageObject\",\n      \"url\": \"https://www.trackman.com/_next/static/media/Trackman_logo--light.05sfd_h_vl6z3.svg\"\n    }\n  },\n  \"breadcrumb\": {\n    \"@type\": \"BreadcrumbList\",\n    \"itemListElement\": [\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 1,\n        \"name\": \"Home\",\n        \"item\": \"https://www.trackman.com\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 2,\n        \"name\": \"Golf\",\n        \"item\": \"https://www.trackman.com/golf\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 3,\n        \"name\": \"Golf Simulator\",\n        \"item\": \"https://www.trackman.com/golf/simulator\"\n      }\n    ]\n  },\n  \"speakable\": {\n    \"@type\": \"SpeakableSpecification\",\n    \"cssSelector\": [\n      \"h1\",\n      \"h2\"\n    ]\n  },\n  \"mainEntity\": {\n    \"@type\": \"ItemList\",\n    \"name\": \"Trackman Simulator Packages\",\n    \"numberOfItems\": 6,\n    \"itemListElement\": [\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 1,\n        \"name\": \"Trackman Golf Simulator Tech Package\",\n        \"url\": \"https://www.trackman.com/golf/products/tech-setup\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 2,\n        \"name\": \"DIY Trackman Flex Cage – X-Small\",\n        \"url\": \"https://www.trackman.com/golf/products/diy-flex-cage-x-small\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 3,\n        \"name\": \"Trackman Flex Cage – Small\",\n        \"url\": \"https://www.trackman.com/golf/products/flex-cage-small\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 4,\n        \"name\": \"Trackman Custom Integrated Golf Simulator Build\",\n        \"url\": \"https://www.trackman.com/golf/products/custom-integrated-build\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 5,\n        \"name\": \"Trackman Flex Cage – Medium\",\n        \"url\": \"https://www.trackman.com/golf/products/flex-cage-medium\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 6,\n        \"name\": \"Trackman Flex Cage – Large\",\n        \"url\": \"https://www.trackman.com/golf/products/flex-cage-large\"\n      }\n    ],\n    \"description\": \"Complete Trackman golf simulator packages. Powered by tour-proven dual radar and camera technology. 500+ courses, Virtual Golf 3, 40+ data parameters. Complete packages from USD 19,290 to USD 57,990+.\"\n  },\n  \"about\": {\n    \"@type\": [\n      \"Product\",\n      \"FAQPage\"\n    ],\n    \"name\": \"Trackman Golf Simulator\",\n    \"description\": \"The world's most accurate indoor golf simulator. Combines dual radar and camera tracking technology used by the PGA Tour, DP World Tour, LPGA Tour, and LIV Golf. Includes Virtual Golf 3 software with 500+ world-class courses and 40+ data parameters. Available for home and commercial use.\",\n    \"url\": \"https://www.trackman.com/golf/simulator\",\n    \"image\": [\n      \"https://a.storyblok.com/f/117513/1200x630/5cecb7dc8f/trackman_golf_simulator.jpg\",\n      \"https://a.storyblok.com/f/117513/1200x1200/bad2ae56e0/the_engins_simulators_trackman_golf.webp\"\n    ],\n    \"brand\": {\n      \"@type\": \"Brand\",\n      \"name\": \"Trackman\",\n      \"url\": \"https://www.trackman.com\"\n    },\n    \"additionalProperty\": [\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Tracking Technology\",\n        \"value\": \"Dual radar and camera\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Number of Courses\",\n        \"value\": \"500+\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Data Parameters\",\n        \"value\": \"40+\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Minimum Space Required\",\n        \"value\": \"8 ft 2 in (2.5 m) from screen to ball\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Recommended Room Size\",\n        \"value\": \"15 ft wide x 10 ft high x 18 ft deep (4.6 m x 3.1 m x 5.5 m)\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Official Tour Partner\",\n        \"value\": \"PGA Tour, DP World Tour, LPGA Tour, LIV Golf\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Software\",\n        \"value\": \"Trackman Performance Studio and Trackman Golf app\"\n      }\n    ],\n    \"isRelatedTo\": [\n      {\n        \"@type\": \"Product\",\n        \"name\": \"Trackman 4\",\n        \"url\": \"https://www.trackman.com/golf/launch-monitors/trackman-4\",\n        \"description\": \"Tour-trusted launch monitor combining radar and camera technology for indoor and outdoor use.\"\n      },\n      {\n        \"@type\": \"Product\",\n        \"name\": \"Trackman iO\",\n        \"url\": \"https://www.trackman.com/golf/launch-monitors/trackman-io\",\n        \"description\": \"Indoor-optimized ceiling-mounted launch monitor purpose-built for home and commercial simulator use.\"\n      }\n    ],\n    \"mainEntity\": [\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How much does a Trackman golf simulator cost?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"The cost of a Trackman golf simulator depends on your space, setup, and software package. Complete simulator packages start from USD 29,490. Options range from the Tech Package (USD 19,290, no enclosure) to the DIY Flex Cage X-Small (USD 29,715), Flex Cage Small with installation (USD 44,540), Custom Integrated Build (from USD 41,740), Flex Cage Medium (USD 52,240), and Flex Cage Large (USD 57,990). Whether it's for your home or a commercial facility, Trackman will help you build a solution that fits your needs.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How much space do I need for a golf simulator?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"For the best experience, Trackman recommends a room that is at least 15 ft wide, 10 ft high, and 18 ft deep (approximately 4.6 m x 3.1 m x 5.5 m). The absolute minimum space required is around 8 ft 2 in (2.5 m) from screen to ball — but actual width and height depend on your swing comfort. For a full breakdown by room type and launch monitor, see the Trackman golf simulator space guide at https://www.trackman.com/blog/golf/how-much-room-for-a-golf-simulator.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How tall does the ceiling need to be for a golf simulator?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Ceiling height depends on your swing and body height. To comfortably swing a driver, most users need at least 9 to 10 feet (2.7–3.1 m). Taller players or those with aggressive swings may require more space to avoid feeling restricted.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How does a Trackman golf simulator work?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Trackman combines radar and camera tracking to measure club and ball data with high precision. Radar tracks the full ball flight while the camera captures impact and early launch data. Together they deliver more accurate readings than systems using only one technology. This data feeds into Virtual Golf 3 software, creating an ultra-realistic indoor experience where what you see on screen matches what happens on the course.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Can I use a Trackman golf simulator at home?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Yes. The Trackman iO Home is purpose-built for home use. It offers the same trusted accuracy and immersive software experience as professional setups without requiring a large space. Whether you are building a dedicated simulator room, garage project, or garden house, Trackman iO makes it possible. Complete home simulator packages start from USD 29,715.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What does a home golf simulator from Trackman include?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"A Trackman home golf simulator is a complete, ready-to-play package. It includes a tour-proven radar and camera launch monitor (the same technology used on the PGA Tour), Virtual Golf 3 software with 500+ world-class courses, and a custom-built enclosure designed to fit your space. Every component is engineered to work together so what you see on screen matches exactly what happens at impact. Complete packages start from USD 29,715 and can be configured for a dedicated golf room, garage, or basement.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What is the best golf simulator for home use?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"The Trackman iO Home is built specifically for golfers who want a simulator in their home. It combines trusted radar and camera technology with ultra-realistic Virtual Golf 3 graphics and access to over 300 world-class courses. It is space-efficient, easy to install, and delivers the same pro-level experience Trackman is known for.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What golf simulator do tour pros use?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Every major professional golf organization — including the PGA Tour, DP World Tour, LPGA Tour, and LIV Golf — independently chose Trackman as their official measurement technology. The same radar technology powering those tours powers every Trackman simulator.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How accurate is a home golf simulator?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Accuracy depends on the technology measuring your shots. Most simulators only track initial launch conditions and model the rest — meaning the data is estimated, not measured. Trackman combines radar and camera technology with models built on billions of measured full ball flights, so what you see on screen matches what happens on the course.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What is the difference between Trackman and other golf simulators?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Most simulators use either camera or radar technology and estimate what they cannot measure. Trackman combines both, using the best of each. Unlike competitors that only track initial launch conditions, Trackman's models are built on billions of measured full ball flights — delivering real data, not estimates.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Is a Trackman simulator worth it?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"If improving your golf game is the goal, accuracy matters. A simulator that shows you the wrong carry distance or spin rate reinforces the wrong habits. Trackman is the only simulator built on the same measurement technology trusted by every major tour and equipment manufacturer — so the feedback you get indoors translates directly to the course. Trackman units from 2016 are still in active use and continuously updated with new courses and features.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What is the most accurate golf simulator?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Trackman is the only golf simulator combining dual radar and camera technology with models built on billions of measured real ball flights. It is the same technology independently chosen by the PGA Tour, DP World Tour, LPGA Tour, LIV Golf, and the R\u0026A — making it the most validated measurement system in golf.\"\n        }\n      }\n    ],\n    \"offers\": {\n      \"@type\": \"AggregateOffer\",\n      \"priceCurrency\": \"USD\",\n      \"lowPrice\": \"19290\",\n      \"highPrice\": \"56240\",\n      \"offerCount\": \"6\",\n      \"availability\": \"https://schema.org/InStock\",\n      \"url\": \"https://www.trackman.com/golf/simulator/get-your-own\"\n    }\n  }\n}"])</script><script>self.__next_f.push([1,"35:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$3c\"}}]\n"])</script><script>self.__next_f.push([1,"1c:[\"$\",\"footer\",null,{\"className\":\"grid-container pt-7 md:pt-24 pb-10\",\"children\":[\"$\",\"section\",null,{\"className\":\"col-start-1 col-span-4 md:col-start-2 md:col-span-6 lg:col-start-3 lg:col-span-12 xl:col-start-5 xl:col-[span_24_/_span_24] 2xl:col-start-9 2xl:col-[span_16_/_span_16]\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex *:w-full gap-6 px-10 md:px-0\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex *:w-full flex-col gap-6 xl:gap-16\",\"children\":[[\"$\",\"div\",null,{\"className\":\"flex flex-col xl:flex-row *:w-full gap-5 xl:gap-10 items-stretch\",\"children\":[[\"$\",\"$L3d\",null,{\"l