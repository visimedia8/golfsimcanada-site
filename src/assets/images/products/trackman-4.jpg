lands,Uganda,Ukraine,United Kingdom,United States,Uruguay,Uzbekistan,Vanuatu,Vietnam,Wallis and Futuna,World,Yemen,Zambia,Zimbabwe,조선민주주의인민공화국"])</script><script>self.__next_f.push([1,"3b:T3133,"])</script><script>self.__next_f.push([1,"{\n  \"@context\": \"https://schema.org\",\n  \"@type\": \"WebPage\",\n  \"name\": \"Trackman Golf Simulator | Most Accurate Indoor Simulator\",\n  \"description\": \"The world's most accurate indoor golf simulator. Tour-proven dual radar and camera technology, Virtual Golf 3, and 500+ courses. Complete simulator packages from USD 29,715. Available for home and commercial use.\",\n  \"url\": \"https://www.trackman.com/golf/simulator\",\n  \"image\": \"https://a.storyblok.com/f/117513/1200x630/5cecb7dc8f/trackman_golf_simulator.jpg\",\n  \"inLanguage\": \"en\",\n  \"publisher\": {\n    \"@type\": \"Organization\",\n    \"name\": \"Trackman\",\n    \"url\": \"https://www.trackman.com\",\n    \"logo\": {\n      \"@type\": \"ImageObject\",\n      \"url\": \"https://www.trackman.com/_next/static/media/Trackman_logo--light.05sfd_h_vl6z3.svg\"\n    }\n  },\n  \"breadcrumb\": {\n    \"@type\": \"BreadcrumbList\",\n    \"itemListElement\": [\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 1,\n        \"name\": \"Home\",\n        \"item\": \"https://www.trackman.com\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 2,\n        \"name\": \"Golf\",\n        \"item\": \"https://www.trackman.com/golf\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 3,\n        \"name\": \"Golf Simulator\",\n        \"item\": \"https://www.trackman.com/golf/simulator\"\n      }\n    ]\n  },\n  \"speakable\": {\n    \"@type\": \"SpeakableSpecification\",\n    \"cssSelector\": [\n      \"h1\",\n      \"h2\"\n    ]\n  },\n  \"mainEntity\": {\n    \"@type\": \"ItemList\",\n    \"name\": \"Trackman Simulator Packages\",\n    \"numberOfItems\": 6,\n    \"itemListElement\": [\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 1,\n        \"name\": \"Trackman Golf Simulator Tech Package\",\n        \"url\": \"https://www.trackman.com/golf/products/tech-setup\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 2,\n        \"name\": \"DIY Trackman Flex Cage – X-Small\",\n        \"url\": \"https://www.trackman.com/golf/products/diy-flex-cage-x-small\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 3,\n        \"name\": \"Trackman Flex Cage – Small\",\n        \"url\": \"https://www.trackman.com/golf/products/flex-cage-small\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 4,\n        \"name\": \"Trackman Custom Integrated Golf Simulator Build\",\n        \"url\": \"https://www.trackman.com/golf/products/custom-integrated-build\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 5,\n        \"name\": \"Trackman Flex Cage – Medium\",\n        \"url\": \"https://www.trackman.com/golf/products/flex-cage-medium\"\n      },\n      {\n        \"@type\": \"ListItem\",\n        \"position\": 6,\n        \"name\": \"Trackman Flex Cage – Large\",\n        \"url\": \"https://www.trackman.com/golf/products/flex-cage-large\"\n      }\n    ],\n    \"description\": \"Complete Trackman golf simulator packages. Powered by tour-proven dual radar and camera technology. 500+ courses, Virtual Golf 3, 40+ data parameters. Complete packages from USD 19,290 to USD 57,990+.\"\n  },\n  \"about\": {\n    \"@type\": [\n      \"Product\",\n      \"FAQPage\"\n    ],\n    \"name\": \"Trackman Golf Simulator\",\n    \"description\": \"The world's most accurate indoor golf simulator. Combines dual radar and camera tracking technology used by the PGA Tour, DP World Tour, LPGA Tour, and LIV Golf. Includes Virtual Golf 3 software with 500+ world-class courses and 40+ data parameters. Available for home and commercial use.\",\n    \"url\": \"https://www.trackman.com/golf/simulator\",\n    \"image\": [\n      \"https://a.storyblok.com/f/117513/1200x630/5cecb7dc8f/trackman_golf_simulator.jpg\",\n      \"https://a.storyblok.com/f/117513/1200x1200/bad2ae56e0/the_engins_simulators_trackman_golf.webp\"\n    ],\n    \"brand\": {\n      \"@type\": \"Brand\",\n      \"name\": \"Trackman\",\n      \"url\": \"https://www.trackman.com\"\n    },\n    \"additionalProperty\": [\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Tracking Technology\",\n        \"value\": \"Dual radar and camera\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Number of Courses\",\n        \"value\": \"500+\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Data Parameters\",\n        \"value\": \"40+\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Minimum Space Required\",\n        \"value\": \"8 ft 2 in (2.5 m) from screen to ball\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Recommended Room Size\",\n        \"value\": \"15 ft wide x 10 ft high x 18 ft deep (4.6 m x 3.1 m x 5.5 m)\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Official Tour Partner\",\n        \"value\": \"PGA Tour, DP World Tour, LPGA Tour, LIV Golf\"\n      },\n      {\n        \"@type\": \"PropertyValue\",\n        \"name\": \"Software\",\n        \"value\": \"Trackman Performance Studio and Trackman Golf app\"\n      }\n    ],\n    \"isRelatedTo\": [\n      {\n        \"@type\": \"Product\",\n        \"name\": \"Trackman 4\",\n        \"url\": \"https://www.trackman.com/golf/launch-monitors/trackman-4\",\n        \"description\": \"Tour-trusted launch monitor combining radar and camera technology for indoor and outdoor use.\"\n      },\n      {\n        \"@type\": \"Product\",\n        \"name\": \"Trackman iO\",\n        \"url\": \"https://www.trackman.com/golf/launch-monitors/trackman-io\",\n        \"description\": \"Indoor-optimized ceiling-mounted launch monitor purpose-built for home and commercial simulator use.\"\n      }\n    ],\n    \"mainEntity\": [\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How much does a Trackman golf simulator cost?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"The cost of a Trackman golf simulator depends on your space, setup, and software package. Complete simulator packages start from USD 29,490. Options range from the Tech Package (USD 19,290, no enclosure) to the DIY Flex Cage X-Small (USD 29,715), Flex Cage Small with installation (USD 44,540), Custom Integrated Build (from USD 41,740), Flex Cage Medium (USD 52,240), and Flex Cage Large (USD 57,990). Whether it's for your home or a commercial facility, Trackman will help you build a solution that fits your needs.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How much space do I need for a golf simulator?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"For the best experience, Trackman recommends a room that is at least 15 ft wide, 10 ft high, and 18 ft deep (approximately 4.6 m x 3.1 m x 5.5 m). The absolute minimum space required is around 8 ft 2 in (2.5 m) from screen to ball — but actual width and height depend on your swing comfort. For a full breakdown by room type and launch monitor, see the Trackman golf simulator space guide at https://www.trackman.com/blog/golf/how-much-room-for-a-golf-simulator.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How tall does the ceiling need to be for a golf simulator?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Ceiling height depends on your swing and body height. To comfortably swing a driver, most users need at least 9 to 10 feet (2.7–3.1 m). Taller players or those with aggressive swings may require more space to avoid feeling restricted.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How does a Trackman golf simulator work?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Trackman combines radar and camera tracking to measure club and ball data with high precision. Radar tracks the full ball flight while the camera captures impact and early launch data. Together they deliver more accurate readings than systems using only one technology. This data feeds into Virtual Golf 3 software, creating an ultra-realistic indoor experience where what you see on screen matches what happens on the course.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Can I use a Trackman golf simulator at home?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Yes. The Trackman iO Home is purpose-built for home use. It offers the same trusted accuracy and immersive software experience as professional setups without requiring a large space. Whether you are building a dedicated simulator room, garage project, or garden house, Trackman iO makes it possible. Complete home simulator packages start from USD 29,715.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What does a home golf simulator from Trackman include?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"A Trackman home golf simulator is a complete, ready-to-play package. It includes a tour-proven radar and camera launch monitor (the same technology used on the PGA Tour), Virtual Golf 3 software with 500+ world-class courses, and a custom-built enclosure designed to fit your space. Every component is engineered to work together so what you see on screen matches exactly what happens at impact. Complete packages start from USD 29,715 and can be configured for a dedicated golf room, garage, or basement.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What is the best golf simulator for home use?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"The Trackman iO Home is built specifically for golfers who want a simulator in their home. It combines trusted radar and camera technology with ultra-realistic Virtual Golf 3 graphics and access to over 300 world-class courses. It is space-efficient, easy to install, and delivers the same pro-level experience Trackman is known for.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What golf simulator do tour pros use?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Every major professional golf organization — including the PGA Tour, DP World Tour, LPGA Tour, and LIV Golf — independently chose Trackman as their official measurement technology. The same radar technology powering those tours powers every Trackman simulator.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"How accurate is a home golf simulator?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Accuracy depends on the technology measuring your shots. Most simulators only track initial launch conditions and model the rest — meaning the data is estimated, not measured. Trackman combines radar and camera technology with models built on billions of measured full ball flights, so what you see on screen matches what happens on the course.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What is the difference between Trackman and other golf simulators?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Most simulators use either camera or radar technology and estimate what they cannot measure. Trackman combines both, using the best of each. Unlike competitors that only track initial launch conditions, Trackman's models are built on billions of measured full ball flights — delivering real data, not estimates.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"Is a Trackman simulator worth it?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"If improving your golf game is the goal, accuracy matters. A simulator that shows you the wrong carry distance or spin rate reinforces the wrong habits. Trackman is the only simulator built on the same measurement technology trusted by every major tour and equipment manufacturer — so the feedback you get indoors translates directly to the course. Trackman units from 2016 are still in active use and continuously updated with new courses and features.\"\n        }\n      },\n      {\n        \"@type\": \"Question\",\n        \"name\": \"What is the most accurate golf simulator?\",\n        \"acceptedAnswer\": {\n          \"@type\": \"Answer\",\n          \"text\": \"Trackman is the only golf simulator combining dual radar and camera technology with models built on billions of measured real ball flights. It is the same technology independently chosen by the PGA Tour, DP World Tour, LPGA Tour, LIV Golf, and the R\u0026A — making it the most validated measurement system in golf.\"\n        }\n      }\n    ],\n    \"offers\": {\n      \"@type\": \"AggregateOffer\",\n      \"priceCurrency\": \"USD\",\n      \"lowPrice\": \"19290\",\n      \"highPrice\": \"56240\",\n      \"offerCount\": \"6\",\n      \"availability\": \"https://schema.org/InStock\",\n      \"url\": \"https://www.trackman.com/golf/simulator/get-your-own\"\n    }\n  }\n}"])</script><script>self.__next_f.push([1,"34:[\"$\",\"$L38\",null,{\"story\":{\"name\":\"Simulator\",\"created_at\":\"2023-07-24T08:42:04.876Z\",\"published_at\":\"2026-07-08T12:35:24.463Z\",\"updated_at\":\"2026-07-08T12:35:24.509Z\",\"id\":344464431,\"uuid\":\"e45050b1-5c4f-4d92-81f6-538938874991\",\"content\":{\"seo\":{\"_uid\":\"def11357-1bfc-4962-96f1-2dd219b5a619\",\"title\":\"Trackman Golf Simulator | Most Accurate Indoor Simulator\",\"plugin\":\"seo_metatags\",\"og_image\":\"https://a.storyblok.com/f/117513/1200x630/5cecb7dc8f/trackman_golf_simulator.jpg\",\"og_title\":\"Trackman Golf Simulator | Most Accurate Indoor Simulator\",\"description\":\"Dual radar + camera tracking delivers the same ball flight data Tour pros rely on — now for your home or facility. 500+ courses, Virtual Golf 3. Complete packages from $29,490.\",\"twitter_image\":\"https://a.storyblok.com/f/117513/1200x630/5cecb7dc8f/trackman_golf_simulator.jpg\",\"twitter_title\":\"Trackman Golf Simulator | Most Accurate Indoor Simulator\",\"og_description\":\"Dual radar + camera tracking delivers the same ball flight data Tour pros rely on — now for your home or facility. 500+ courses, Virtual Golf 3. Complete packages from $29,490.\",\"twitter_description\":\"Dual radar + camera tracking delivers the same ball flight data Tour pros rely on — now for your home or facility. 500+ courses, Virtual Golf 3. Complete packages from $29,490.\"},\"_uid\":\"5a62d384-a753-4f82-85c4-a6b20f323061\",\"body\":[\"$6:0:0:props:children:0:props:blok\",{\"cta\":[{\"url\":{\"id\":\"d7c0cabb-1f7a-4369-bcae-0622ae87c533\",\"url\":\"\",\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"blog/golf/what-is-a-golf-launch-monitor\"},\"_uid\":\"92e022a5-16b4-4735-9c80-b2129bd9d043\",\"label\":\"Learn more\",\"component\":\"link\",\"variation\":\"primary\"}],\"_uid\":\"85573928-8f51-45e6-9d95-591d5382a04c\",\"image\":{\"id\":183818597909161,\"alt\":\"Person playing golf in an indoor simulator, displaying a green course and shot trajectory on a screen.\",\"name\":\"\",\"focus\":\"\",\"title\":\"why_accuracy_matters_desktop\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/3840x2160/ecd846d9fd/why_accuracy_matters_desktop.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Person playing golf in an indoor simulator, displaying a green course and shot trajectory on a screen.\",\"title\":\"why_accuracy_matters_desktop\",\"source\":\"\",\"copyright\":\"Trackman\"},\"is_external_url\":false},\"label\":\"\",\"video\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2,\"textAlign\":null},\"content\":[{\"text\":\"Why accuracy matters\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Camera and radar each have strengths and weaknesses. Most simulators use one or the other — and estimate what they can't measure.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Trackman combines both, using the best of each technology. And unlike competitors that only track initial launch conditions, our models are built on billions of measured full ball flights.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"What you see on screen matches what happens on the course.\",\"type\":\"text\"}]}]},\"component\":\"hero\",\"video_url\":\"\",\"above_fold\":false,\"hero_height\":\"100\",\"mobile_image\":{\"id\":183806653095936,\"alt\":\"Golfer swings in an indoor simulator, displaying a virtual golf course on a large screen with lush greenery and a blue sky.\",\"name\":\"\",\"focus\":\"\",\"title\":\"Why accuracy matters_mobile\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/786x1704/ea75e96030/why-accuracy-matters_mobile.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Golfer swings in an indoor simulator, displaying a virtual golf course on a large screen with lush greenery and a blue sky.\",\"title\":\"Why accuracy matters_mobile\",\"source\":\"\",\"copyright\":\"Trackman\"},\"is_external_url\":false},\"mobile_video\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"content_align\":\"left\",\"mobile_video_url\":\"\",\"pop_up_video_url\":\"\",\"scroll_indicator\":false,\"hero_height_mobile\":\"\",\"mobile_content_align\":\"bottom\",\"scroll_indicator_label\":\"\"},{\"cta\":[],\"_uid\":\"e5300940-9173-439e-976d-be592f43cd9a\",\"layout\":\"\",\"content\":\"\",\"heading\":[],\"padding\":[{\"top\":\"xl\",\"_uid\":\"780a8805-32e9-4949-a64a-9457d7988527\",\"bottom\":\"l\",\"option\":\"\",\"component\":\"padding\"}],\"component\":\"text_component\",\"dark_theme\":true,\"rich_content\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2},\"content\":[{\"text\":\"THREE COMPONENTS, ENDLESS POSSIBILITIES\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"content\":[{\"text\":\"A golf simulator consists of three connected components: the engine, the software and the space. Here’s a closer look at how Trackman brings them all together to deliver the best of indoor golf.\",\"type\":\"text\"}]}]},\"content_align\":\"center\"},{\"cta\":[{\"url\":{\"id\":\"88fcc047-bb60-49a6-b500-f67472a0d38a\",\"url\":\"\",\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"golf/launch-monitors/\"},\"_uid\":\"59275089-57ad-46e9-89f2-b277e18f8024\",\"label\":\"Learn more\",\"component\":\"link\",\"variation\":\"primary\"}],\"_uid\":\"1421b662-d6f8-4032-b1c1-24870daf8a83\",\"image\":{\"id\":104153347238904,\"alt\":\"Two TrackMan devices, one orange and one black, featuring cameras and sleek designs, used for sports performance analysis.\",\"name\":\"\",\"focus\":\"\",\"title\":\"the_engins_simulators_trackman_golf\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/1200x1200/bad2ae56e0/the_engins_simulators_trackman_golf.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Two TrackMan devices, one orange and one black, featuring cameras and sleek designs, used for sports performance analysis.\",\"title\":\"the_engins_simulators_trackman_golf\",\"source\":\"\",\"copyright\":\"Trackman\"},\"content_type\":\"png\",\"is_external_url\":false},\"video\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"padding\":[{\"top\":\"m\",\"_uid\":\"0d5d721b-63f3-4854-b04e-620102fd5b92\",\"bottom\":\"m\",\"component\":\"padding\"}],\"component\":\"media_with_text\",\"video_url\":\"\",\"dark_theme\":true,\"image_fill\":\"cover\",\"rich_content\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2,\"textAlign\":null},\"content\":[{\"text\":\"THE ENGINE\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Both of our launch monitors — the tour-trusted \",\"type\":\"text\"},{\"text\":\"Trackman 4\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/golf/launch-monitors/trackman-4\",\"uuid\":\"fc388458-1b3c-48e0-80d5-dc64aadbfbd2\",\"anchor\":null,\"target\":\"_self\",\"linktype\":\"story\"}}]},{\"text\":\" and the indoor-optimized \",\"type\":\"text\"},{\"text\":\"Trackman iO\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/golf/launch-monitors/trackman-io\",\"uuid\":\"c2cd463f-d3ce-46aa-839d-0c1eb58c2977\",\"anchor\":null,\"target\":\"_self\",\"linktype\":\"story\"}}]},{\"text\":\" — combine radar and camera technology to deliver unsurpassed accuracy.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"The same technology trusted by the PGA Tour, DP World Tour, LPGA Tour and LIV Golf as their official measurement technology — now available for your home or facility.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"We'll work with you to identify the best option for your needs, location and budget.\",\"type\":\"text\"}]}]},\"layout_mobile\":\"img_top\",\"layout_desktop\":\"img_left\",\"video_thumbnail\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"image_aspect_ratio\":\"1/1\"},{\"cta\":[{\"url\":{\"id\":\"2b25cf35-0a65-4512-adba-bbd189f62cc2\",\"url\":\"\",\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"golf/launch-monitors/software\"},\"_uid\":\"157b1610-c6e2-4a60-bf06-8968e6f7cff0\",\"label\":\"Learn more\",\"component\":\"link\",\"variation\":\"primary\"}],\"_uid\":\"676475a2-a74a-45cb-9536-24a999fc733d\",\"image\":{\"id\":178556644790012,\"alt\":\"A screen displaying various golf training options like shot analysis, performance center, and test center under the \\\"Practice\\\" section.\",\"name\":\"\",\"focus\":\"\",\"title\":\"simulators_overview_image\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/1080x1080/7a894c0504/simulators_overview_image.webp\",\"copyright\":\"\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"A screen displaying various golf training options like shot analysis, performance center, and test center under the \\\"Practice\\\" section.\",\"title\":\"simulators_overview_image\",\"source\":\"\",\"copyright\":\"\"},\"content_type\":\"png\",\"is_external_url\":false},\"video\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"padding\":[{\"top\":\"m\",\"_uid\":\"baa7a938-c537-4e18-9f58-8443d6799e3b\",\"bottom\":\"l\",\"component\":\"padding\"}],\"component\":\"media_with_text\",\"video_url\":\"\",\"dark_theme\":true,\"image_fill\":\"cover\",\"rich_content\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2,\"textAlign\":null},\"content\":[{\"text\":\"THE SOFTWARE\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Your simulator runs on the most comprehensive software package in the industry — \",\"type\":\"text\"},{\"text\":\"Trackman Performance Studio\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/golf/launch-monitors/software\",\"uuid\":\"2b25cf35-0a65-4512-adba-bbd189f62cc2\",\"anchor\":null,\"target\":\"_self\",\"linktype\":\"story\"}}]},{\"text\":\" and the Trackman Golf app.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Play 500+ world-class courses with ultra-realistic graphics. Analyze every shot with more than 40 data parameters. Track improvement over time. Practice with purpose using dedicated training modes built for every skill level.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Regular updates mean your simulator keeps improving — Trackman units from 2016 are still in active use, continuously updated with new courses, features and performance improvements.\",\"type\":\"text\"}]}]},\"layout_mobile\":\"img_top\",\"layout_desktop\":\"img_right\",\"video_thumbnail\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"image_aspect_ratio\":\"1/1\"},{\"cta\":[{\"url\":{\"id\":\"4058e732-1ca0-4466-8c4b-133aa0921ec6\",\"url\":\"\",\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"golf/simulator/build-outs\"},\"_uid\":\"b077bf41-8e01-46cc-90f3-fcf246235122\",\"label\":\"See Simulators\",\"component\":\"link\",\"variation\":\"primary\"},{\"url\":{\"id\":\"1b2a28cc-e0d2-445a-8462-a60e2a75df3d\",\"url\":\"\",\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"golf/simulator/sim-builder\"},\"_uid\":\"6568cd26-60fd-42da-b8ac-1ac1d42bbafc\",\"label\":\"Try Sim Builder\",\"component\":\"link\",\"variation\":\"secondary\"}],\"_uid\":\"ed04c677-d36c-4755-abf0-08627ae5ddbe\",\"image\":{\"id\":183824571327536,\"alt\":\"Golf instructor guiding a student on swing technique indoors, with equipment and seating visible in the background.\",\"name\":\"\",\"focus\":\"\",\"title\":\"the_space_trackman\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/3840x2160/f54f4e88ff/the_space_trackman.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Golf instructor guiding a student on swing technique indoors, with equipment and seating visible in the background.\",\"title\":\"the_space_trackman\",\"source\":\"\",\"copyright\":\"Trackman\"},\"is_external_url\":false},\"video\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"heading\",\"attrs\":{\"level\":2,\"textAlign\":null},\"content\":[{\"text\":\"THE SPACE\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Every home, golf club, coaching studio and indoor facility is unique. That's why we take a consultative approach — working with you to design a setup that fits your specific space, budget and goals, whether for entertainment, serious practice or both.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"For a quick starting point, try the \",\"type\":\"text\"},{\"text\":\"Sim Builder\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/golf/simulator/sim-builder\",\"uuid\":\"1b2a28cc-e0d2-445a-8462-a60e2a75df3d\",\"anchor\":null,\"target\":\"_self\",\"linktype\":\"story\"}}]},{\"text\":\" to configure your space in minutes. Or browse real \",\"type\":\"text\"},{\"text\":\"build-outs\",\"type\":\"text\",\"marks\":[{\"type\":\"link\",\"attrs\":{\"href\":\"/golf/simulator/build-outs\",\"uuid\":\"4058e732-1ca0-4466-8c4b-133aa0921ec6\",\"anchor\":null,\"target\":\"_self\",\"linktype\":\"story\"}}]},{\"text\":\" from Trackman customers for inspiration.\",\"type\":\"text\"}]},{\"type\":\"paragraph\",\"attrs\":{\"textAlign\":null},\"content\":[{\"text\":\"Minimum space required is 8 ft 2 in (2.5m) from screen to ball. For the best experience we recommend at least 15 ft wide, 10 ft high and 18 ft deep.\",\"type\":\"text\"}]}]},\"component\":\"hero\",\"video_url\":\"\",\"above_fold\":false,\"hero_height\":\"100\",\"mobile_image\":{\"id\":178561481732372,\"alt\":\"Two men in a golf lesson, focusing on swing technique, with clubs and a golf bag nearby indoors.\",\"name\":\"\",\"focus\":\"\",\"title\":\"simulators_overview_hero1_mobile\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/786x1704/f92e72d1f0/simulators_overview_hero1_mobile.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Two men in a golf lesson, focusing on swing technique, with clubs and a golf bag nearby indoors.\",\"title\":\"simulators_overview_hero1_mobile\",\"source\":\"\",\"copyright\":\"Trackman\"},\"is_external_url\":false},\"mobile_video\":{\"id\":null,\"alt\":null,\"name\":\"\",\"focus\":null,\"title\":null,\"source\":null,\"filename\":\"\",\"copyright\":null,\"fieldtype\":\"asset\",\"meta_data\":{}},\"content_align\":\"right\",\"mobile_video_url\":\"\",\"pop_up_video_url\":\"\",\"scroll_indicator\":false,\"hero_height_mobile\":\"\",\"mobile_content_align\":\"bottom\",\"scroll_indicator_label\":\"\"},\"$2e:props:blok\",\"$2f:props:blok\",{\"cta\":[{\"url\":{\"id\":\"e0b6487d-6ee6-4b6e-9069-d2dd69ee7263\",\"url\":\"\",\"linktype\":\"story\",\"fieldtype\":\"multilink\",\"cached_url\":\"lp/trackman-booking-payments\"},\"_uid\":\"4d2527e4-b43a-431c-b748-1ca5204cab91\",\"label\":\"Learn more\",\"component\":\"link\",\"variation\":\"primary\"}],\"_uid\":\"bbd31da1-db08-4811-956b-a1c7965aeaa4\",\"ima