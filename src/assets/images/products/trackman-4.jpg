r py-2 px-6 hover:bg-[#ab490e] hover:border-[#ab490e]\",\"style\":\"$undefined\",\"ref\":null}]]}]]}]}]}]]}]\n"])</script><script>self.__next_f.push([1,"2e:[\"$\",\"$L36\",\"e6f093fa-b83c-4122-83d5-f7059d99b064\",{\"ref\":\"$undefined\",\"blok\":{\"_uid\":\"e6f093fa-b83c-4122-83d5-f7059d99b064\",\"content\":{\"type\":\"doc\",\"content\":[{\"type\":\"paragraph\"}]},\"component\":\"large_media_slider\",\"is_header\":false,\"carousel_items\":[{\"_uid\":\"b8b421c7-e5ef-427d-9aa7-6eba72fd5391\",\"image\":{\"id\":178556644769530,\"alt\":\"Indoor golf simulator setup with projector and screen, offering options like practice, courses, competitions, games, and online activities.\",\"name\":\"\",\"focus\":\"\",\"title\":\"TM4_slider1\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/3840x1940/e7df2fad93/tm4_slider1.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Indoor golf simulator setup with projector and screen, offering options like practice, courses, competitions, games, and online activities.\",\"title\":\"TM4_slider1\",\"source\":\"\",\"copyright\":\"Trackman\"},\"content_type\":\"png\",\"is_external_url\":false},\"content\":\"The portable Trackman 4 device is placed on the ground behind the hitting area. If you want to practice or play outdoors, simply pick it up and go.\",\"heading\":[{\"_uid\":\"b9e614dc-b2e2-4f76-9a80-d585c8bb6002\",\"isH1\":false,\"title\":\"\u003cu\u003eTRACKMAN 4\u003c/u\u003e\u003cbr\u003e SOLUTION\",\"component\":\"title_heading\"}],\"component\":\"carousel_item\",\"tab_title\":\"Trackman 4 solution\",\"mobile_image\":{\"id\":178556644732663,\"alt\":\"Indoor golf simulator with a projector, green mat, and screen displaying options like practice, courses, competitions, games, and online play.\",\"name\":\"\",\"focus\":\"\",\"title\":\"TM4_slider1_mobile\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/1179x837/da233775eb/tm4_slider1_mobile.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Indoor golf simulator with a projector, green mat, and screen displaying options like practice, courses, competitions, games, and online play.\",\"title\":\"TM4_slider1_mobile\",\"source\":\"\",\"copyright\":\"Trackman\"},\"content_type\":\"png\",\"is_external_url\":false},\"content_align\":\"default\",\"tab_title_uppercase\":false},{\"_uid\":\"7bb40855-5b61-43e5-aac1-fc398bafbc29\",\"image\":{\"id\":178556644781819,\"alt\":\"Diagram of a dark room with dimensions: 4.6m wide, 3m high, 5.5m deep. Includes a computer desk and wall-mounted device.\",\"name\":\"\",\"focus\":\"\",\"title\":\"TM4_slider2\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/3840x1940/930e2b418d/tm4_slider2.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Diagram of a dark room with dimensions: 4.6m wide, 3m high, 5.5m deep. Includes a computer desk and wall-mounted device.\",\"title\":\"TM4_slider2\",\"source\":\"\",\"copyright\":\"Trackman\"},\"content_type\":\"png\",\"is_external_url\":false},\"content\":\"The Doppler radar technology in Trackman 4 requires minimum space in front of and behind the ball for optimal performance. These recommended dimensions may be adjusted slightly; consult with a sales representative for details.\",\"heading\":[{\"_uid\":\"63ea9488-990a-4e16-80b8-3335fb2fa709\",\"isH1\":false,\"title\":\"\u003cu\u003eTRACKMAN 4\u003c/u\u003e \u003cbr\u003eSPACE\",\"component\":\"title_heading\"}],\"component\":\"carousel_item\",\"tab_title\":\"Space recommendations\",\"mobile_image\":{\"id\":178556644798205,\"alt\":\"Diagram of a room with dimensions: 10+ ft (3m) high, 15+ ft (4.6m) wide, 18+ ft (5.5m) long, and a screen on a cabinet.\",\"name\":\"\",\"focus\":\"\",\"title\":\"TM4_slider2_mobile\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/1179x840/a6cbd9ecba/tm4_slider2_mobile.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Diagram of a room with dimensions: 10+ ft (3m) high, 15+ ft (4.6m) wide, 18+ ft (5.5m) long, and a screen on a cabinet.\",\"title\":\"TM4_slider2_mobile\",\"source\":\"\",\"copyright\":\"Trackman\"},\"content_type\":\"png\",\"is_external_url\":false},\"content_align\":\"default\",\"tab_title_uppercase\":false}]}}]\n"])</script><script>self.__next_f.push([1,"2f:[\"$\",\"$L36\",\"ce0af725-b0a2-4875-b046-3f7fd90fdbb2\",{\"ref\":\"$undefined\",\"blok\":{\"_uid\":\"ce0af725-b0a2-4875-b046-3f7fd90fdbb2\",\"component\":\"large_media_slider\",\"is_header\":false,\"carousel_items\":[{\"_uid\":\"5713ae29-0a8c-433c-936c-89a62d8422d9\",\"image\":{\"id\":178556644724470,\"alt\":\"A dark indoor golf simulator room with a large screen displaying various activity options, including practice, courses, competitions, and games.\",\"name\":\"\",\"focus\":\"\",\"title\":\"TMio_slider1\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/3840x1940/15e7eeed4f/tmio_slider1.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"A dark indoor golf simulator room with a large screen displaying various activity options, including practice, courses, competitions, and games.\",\"title\":\"TMio_slider1\",\"source\":\"\",\"copyright\":\"Trackman\"},\"content_type\":\"png\",\"is_external_url\":false},\"content\":\"Trackman iO is ceiling mounted, ensuring the device is always properly calibrated and freeing up valuable space on the ground.\",\"heading\":[{\"_uid\":\"7f1cf19e-8ee3-4c09-938f-b2393a02dc25\",\"isH1\":false,\"title\":\"\u003cu\u003eTRACKMAN iO\u003c/u\u003e \u003cbr\u003eSOLUTION\",\"component\":\"title_heading\"}],\"component\":\"carousel_item\",\"tab_title\":\"Trackman iO solution\",\"mobile_image\":{\"id\":178556644761337,\"alt\":\"Golf simulator setup in a dark room, featuring a screen displaying activities: Practice, Courses, Competitions, Games, and Online options.\",\"name\":\"\",\"focus\":\"\",\"title\":\"TMio_slider1_mobile\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/1179x837/b05c507feb/tmio_slider1_mobile.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Golf simulator setup in a dark room, featuring a screen displaying activities: Practice, Courses, Competitions, Games, and Online options.\",\"title\":\"TMio_slider1_mobile\",\"source\":\"\",\"copyright\":\"Trackman\"},\"content_type\":\"png\",\"is_external_url\":false},\"content_align\":\"right\",\"tab_title_uppercase\":false},{\"_uid\":\"93a5f8f9-5908-4c89-a89d-be6192da905a\",\"image\":{\"id\":178556644843262,\"alt\":\"Outline of a rectangular room with dimensions 15+ (4.6m) by 10+ (3m), showing a computer on a desk in the corner, set against a dark background.\",\"name\":\"\",\"focus\":\"\",\"title\":\"TMio_slider2\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/3840x1940/440f94be0c/tmio_slider2.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"Outline of a rectangular room with dimensions 15+ (4.6m) by 10+ (3m), showing a computer on a desk in the corner, set against a dark background.\",\"title\":\"TMio_slider2\",\"source\":\"\",\"copyright\":\"Trackman\"},\"content_type\":\"png\",\"is_external_url\":false},\"content\":\"Thanks to the revolutionary combination of tracking technologies in Trackman iO, all you need is enough room to comfortably swing a club.\",\"heading\":[{\"_uid\":\"fc29fa30-2169-43a5-8b8f-95859ce196d1\",\"isH1\":false,\"title\":\"\u003cu\u003eTRACKMAN iO\u003c/u\u003e \u003cbr\u003eSPACE\",\"component\":\"title_heading\"}],\"component\":\"carousel_item\",\"tab_title\":\"Space recommendations\",\"mobile_image\":{\"id\":178556644921088,\"alt\":\"A dark, minimalist room with white outlined dimensions for a projection setup: 15+ ft length, 10+ ft width and height, with a small cabinet.\",\"name\":\"\",\"focus\":\"\",\"title\":\"TMio_slider2_mobile\",\"source\":\"\",\"filename\":\"https://a.storyblok.com/f/117513/1179x840/a58a56449c/tmio_slider2_mobile.webp\",\"copyright\":\"Trackman\",\"fieldtype\":\"asset\",\"meta_data\":{\"alt\":\"A dark, minimalist room with white outlined dimensions for a projection setup: 15+ ft length, 10+ ft width and height, with a small cabinet.\",\"title\":\"TMio_slider2_mobile\",\"source\":\"\",\"copyright\":\"Trackman\"},\"content_type\":\"png\",\"is_external_url\":false},\"content_align\":\"right\",\"tab_title_uppercase\":false}]}}]\n"])</script><script>self.__next_f.push([1,"30:[\"$\",\"section\",\"bbd31da1-db08-4811-956b-a1c7965aeaa4\",{\"className\":\"px-10 lg:px-0 bg-tm-c-dark text-tm-c-light pt-[3.75rem] pb-[3.75rem]\",\"children\":[\"$\",\"div\",null,{\"className\":\"grid-container\",\"children\":[[\"$\",\"div\",null,{\"className\":\"relative self-center aspect-square col-start-1 col-span-4 md:ml-5 md:col-start-5 md:col-span-4 lg:ml-0 lg:col-start-10 lg:col-span-5 xl:col-start-18 xl:col-span-9 row-start-1 mb-6 md:mb-0\",\"children\":[[\"$\",\"$L11\",null,{\"src\":\"https://a.storyblok.com/f/117513/1200x1200/884fed7438/simulators_overview_image1.webp\",\"alt\":\"A computer screen displays a booking and payment grid interface, with a keyboard and mouse on the desk below.\",\"fill\":true,\"sizes\":\"(min-width: 1280px) 28vw, (min-width: 1024px) 40vw, (min-width: 768px) 50vw, 100vw\",\"className\":\"w-full h-full object-cover\",\"quality\":100}],false]}],[\"$\",\"div\",null,{\"className\":\"flex flex-col justify-center text-center md:text-left [\u0026_h1]:drop-shadow-2xl [\u0026_h2]:drop-shadow-2xl [\u0026_p]:drop-shadow-2xl col-start-1 col-span-4 md:mr-5 lg:mr-0 lg:col-start-3 lg:col-span-6 xl:col-start-7 xl:col-span-9 row-start-2 md:row-start-1\",\"children\":[\"$undefined\",[[\"$\",\"h2\",\"0\",{\"className\":\"mb-6 [\u0026\u003eu]:no-underline [\u0026\u003eu]:text-tm-c-primary\",\"children\":[\"BOOKING \u0026 PAYMENTS\"]}],[\"$\",\"p\",\"1\",{\"className\":\"font-medium text-base lg:text-lg mb-5 last-of-type:mb-0 [\u0026\u003eu]:no-underline [\u0026\u