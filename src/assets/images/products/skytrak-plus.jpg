  section-full bg-custom text-custom"style="--background: 0 0 0; --text-color: 255 255 255;">
    <div
      
    >
      <div class="impact-text impact-text--center "><div class="snap-center" ><h2 class="impact-text__text heading break-all">
                <impact-text
                  
                    count-up="2"
                  
                  reveal-js
                ><span class="text-gradient " style="--gradient: linear-gradient(46deg, rgba(255, 255, 255, 1) 13%, rgba(79, 82, 81, 1) 86%)">2 YDS</span></impact-text>
              </h2><div class="impact-text__content">
                <div class="prose"><h3 class="h4">SKYTRAK ST+ boasts precision within 2 yards of the industry&#39;s leading professional launch monitors costing upwards of $20,000. Providing insights and accuracy to give your game the upgrade it needs.</h3><p>Based on 3rd party testing data by <a href="https://www.youtube.com/watch?v=L1UbTUx3lFQ" target="_blank" title="https://www.youtube.com/watch?v=L1UbTUx3lFQ">GolfBays</a></p></div>
              </div></div></div>
