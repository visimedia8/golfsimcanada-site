  jdgm.data.reviewWidget[8522055844146] = {"number_of_reviews":1382,"average_rating":"4.66","number_of_questions":0,"product_name":"SKYTRAK ST+ Launch Monitor","product_external_id":8522055844146,"product_coupons_enabled":true,"image_url":"https://cdn.shopify.com/s/files/1/0794/0361/4514/files/SkyTrak_white_launch_monitor_with_14-day_free_trial_offer..jpg?v=1781033925","histogram":[{"rating":5,"frequency":921,"percentage":67,"extra_class":null},{"rating":4,"frequency":460,"percentage":33,"extra_class":null},{"rating":3,"frequency":0,"percentage":0,"extra_class":null},{"rating":2,"frequency":1,"percentage":0,"extra_class":null},{"rating":1,"frequency":0,"percentage":0,"extra_class":null}],"review_keywords":null,"product_medals":[{"type":"tran","tier":"bronze","tier_key":100,"medal_image_url":"https://judgeme-public-images.imgix.net/judgeme/medals-v2-2025-rebranding/tran/bronze.svg","title":"Bronze Transparent Shop","description":"Published at least 80% of verified reviews received in total","value":86.2}],"custom_form_filters_and_averages":null,"photo_gallery":[{"uuid":"c60ec8cf-e4a6-4e05-a4a2-334aadda2f51","reviewer_name":"CoachGilbert","reviewer_initial":"C","title":"Love it! Very accurate, but...","body_html":"<p>Love it! Very accurate. But itdoesn't hold a charge very good. Maybe 2 to 3 hours fully charged.<\/p>","verified_buyer":true,"location":"","video_external_ids":[],"media_platform_hosted_video_infos":[],"cf_answers":[],"rating":"4","created_at":"2025-12-02 23:58:50 UTC","pictures_urls":[{"original":"https://review-images.judge.me/skytrak/1764719975__1764719971913-20251201_185748__original.jpg?quality=80&width=1024","small":"https://review-images.judge.me/skytrak/1764719975__1764719971913-20251201_185748__original.jpg?quality=80&width=160","compact":"https://review-images.judge.me/skytrak/1764719975__1764719971913-20251201_185748__original.jpg?quality=80&width=160","huge":"https://review-images.judge.me/skytrak/1764719975__1764719971913-20251201_185748__original.jpg?quality=80&width=1024"}]},{"uuid":"bee8bb75-eee0-4f13-9692-0907c81c9e4b","reviewer_name":"J.J.","reviewer_initial":"J","title":"Just plain awesome!","body_html":"<p>No complaints. Everything I expected. Looking forward to lowering my scores.<\/p>","verified_buyer":true,"location":"","video_external_ids":[],"media_platform_hosted_video_infos":[],"cf_answers":[],"rating":"5","created_at":"2025-02-25 18:55:27 UTC","pictures_urls":[{"original":"https://review-images.judge.me/skytrak/1740509852__1740509845168-img_7128__original.jpeg?quality=80&width=1024","small":"https://review-images.judge.me/skytrak/1740509852__1740509845168-img_7128__original.jpeg?quality=80&width=160","compact":"https://review-images.judge.me/skytrak/1740509852__1740509845168-img_7128__original.jpeg?quality=80&width=160","huge":"https://review-images.judge.me/skytrak/1740509852__1740509845168-img_7128__original.jpeg?quality=80&width=1024"}]},{"uuid":"02c2c6bf-a282-412b-957b-a76d4ea38340","reviewer_name":"George Smith","reviewer_initial":"G","title":"Great update","body_html":"<p>Love the new data the SkyTrak+ provides<\/p>","verified_buyer":true,"location":"","video_external_ids":[],"media_platform_hosted_video_infos":[],"cf_answers":[],"rating":"5","created_at":"2025-02-23 20:51:36 UTC","pictures_urls":[{"original":"https://review-images.judge.me/skytrak/1740343985__1740343953996-img_6953__original.jpeg?quality=80&width=1024","small":"https://review-images.judge.me/skytrak/1740343985__1740343953996-img_6953__original.jpeg?quality=80&width=160","compact":"https://review-images.judge.me/skytrak/1740343985__1740343953996-img_6953__original.jpeg?quality=80&width=160","huge":"https://review-images.judge.me/skytrak/1740343985__1740343953996-img_6953__original.jpeg?quality=80&width=1024"}]}],"review_summary_text":"Based on 1382 reviews","ai_summary_text":"Launch monitor praised for accuracy and comprehensive data including club path and face angle. Customers said it's a \"massive improvement over the original\" with faster response times. Some noted connection issues, battery life concerns, and occasional missed reads. Setup can be challenging initially. Elevation calculations and bunker shot detection need improvement.","sort_key":"created_at","multi_language_sorting_enabled":false,"metafield_updated_at":"2026-06-30T20:26:04Z","ai_summary_translations":{"ja":{"text":"ローンチモニターは、クラブパスやフェースアングルなどの正確さと包括的なデータで高く評価されました。顧客からは、応答時間が短縮され、「オリジナルよりも大幅に改善された」との声が上がりました。中には接続の問題、バッテリー寿命の懸念、ときどき読み逃しがあったという指摘もありました。初期設定は難しい場合があります。標高計算とバンカーショットの検出には改善が必要です。","highlights":[{"highlight":"何分の一かの価格ですべて同じデータが得られるような気がします。","review_uuid":"40fa28d3-cf58-4947-88e6-0ddb0b5e9fd8"},{"highlight":"ゴルフを上達させるために今までに購入した中で最高のものです！","review_uuid":"bf8c3453-c86c-46da-ac74-aea675a684a4"},{"highlight":"素晴らしいユニットで、アップグレードする価値がありました！","review_uuid":"3e73bcd5-89f5-4a00-9fe4-5bffbe083188"}]},"fr":{"text":"Le moniteur de lancement est apprécié pour sa précision et ses données complètes, notamment la trajectoire du club et l'angle de la face. Les clients ont déclaré qu'il s'agissait d'une « amélioration considérable par rapport à l'original » avec des temps de réponse plus rapides. Certains ont noté des problèmes de connexion, des problèmes d'autonomie de la batterie et des lectures manquées occasionnelles. La configuration peut être difficile au début. Les calculs d'altitude et la détection des tirs dans les bunkers doivent être améliorés.","highlights":[{"highlight":"J'ai l'impression d'obtenir les mêmes données... pour une fraction du prix.","review_uuid":"40fa28d3-cf58-4947-88e6-0ddb0b5e9fd8"},{"highlight":"C'est la meilleure chose que j'ai jamais achetée pour améliorer mon jeu de golf !","review_uuid":"bf8c3453-c86c-46da-ac74-aea675a684a4"},{"highlight":"Super unité, ça valait vraiment la peine d'être améliorée !","review_uuid":"3e73bcd5-89f5-4a00-9fe4-5bffbe083188"}]},"es":{"text":"El monitor de lanzamiento fue elogiado por su precisión y sus datos completos, incluida la trayectoria del palo y el ángulo de la cara. Los clientes dijeron que es una «mejora enorme con respecto al original», con tiempos de respuesta más rápidos. Algunos señalaron problemas de conexión, problemas con la duración de la batería y, en ocasiones, errores de lectura. La configuración puede ser difícil al principio. Es necesario mejorar los cálculos de elevación y la detección de disparos de búnker.","highlights":[{"highlight":"Siento que obtengo los mismos datos... por una fracción del precio.","review_uuid":"40fa28d3-cf58-4947-88e6-0ddb0b5e9fd8"},{"highlight":"¡Lo mejor que he comprado para mejorar mi juego de golf!","review_uuid":"bf8c3453-c86c-46da-ac74-aea675a684a4"},{"highlight":"Gran unidad, ¡valió la pena la mejora!","review_uuid":"3e73bcd5-89f5-4a00-9fe4-5bffbe083188"}]},"en":{"text":"Launch monitor praised for accuracy and comprehensive data including club path and face angle. Customers said it's a \"massive improvement over the original\" with faster response times. Some noted connection issues, battery life concerns, and occasional missed reads. Setup can be challenging initially. Elevation calculations and bunker shot detection need improvement.","highlights":[{"highlight":"Great unit, was totally worth the upgrade!","review_uuid":"3e73bcd5-89f5-4a00-9fe4-5bffbe083188"},{"highlight":"I feel like I get all the same data...for a fraction of the price.","review_uuid":"40fa28d3-cf58-4947-88e6-0ddb0b5e9fd8"},{"highlight":"Best thing I've ever purchased to improve my golf game!","review_uuid":"bf8c3453-c86c-46da-ac74-aea675a684a4"}]}},"reviews":[{"uuid":"9bf3a771-0965-5408-bb96-913c3b4c5f50","title":"","rating":5,"body_html":"<p>Ive never been happier<\/p>","body":"Ive never been happier","verified_buyer":true,"created_at":"2026-01-13T20:12:41.000Z","reviewer_name":"J.A.","reviewer_initial":"J","is_anonymous_reviewer":false,"cf_answers":[],"reply_content":null,"pictures_urls":[],"video_external_ids":[],"thumb_up":0,"thumb_down":0,"location_country":"","location_country