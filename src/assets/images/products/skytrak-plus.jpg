        os2_products: {},
        product: {"id":8522055844146,"title":"SKYTRAK ST+ Launch Monitor","handle":"skytrak-plus-launch-monitor","description":"\u003cp\u003e\u003cspan\u003eThe SKYTRAK ST+ Launch Monitor redefines practice with advanced radar and camera technology. Designed for accuracy and versatility, it delivers powerful features in a portable design. Elevate your game like never before and play anytime, anywhere. \u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan\u003e\u003cstrong\u003eDual Doppler Radar Technology\u003c\/strong\u003e - Captures precise club data, offering \u003c\/span\u003ecritical insights to refine your swing and ball flight. \u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eAdvanced Photometric Camera System\u003c\/strong\u003e - Provides enhanced ball tracking for more accurate readings and a better practice experience. \u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eGlobal Course Access\u003c\/strong\u003e - Play on world-class courses from home and enjoy immersive golf experiences. \u003c\/p\u003e\n\u003cp\u003e\u003cstrong\u003eTrial Membership\u003c\/strong\u003e \u003cmeta charset=\"utf-8\"\u003e— 14-day access to play Sweetens Cove plus all game improvement features including proprietary GOLFTEC Practice Ranges.\u003c\/p\u003e\n\u003cp\u003e\u003cem\u003eTo unlock all features in the SKYTRAK App add a Membership Plan. \u003cb id=\"docs-internal-guid-ed92349f-7fff-63b5-0218-12319c5e54be\"\u003e\u003ca href=\"https:\/\/skytrakgolf.com\/pages\/membership\" title=\"SKYTRAK Membership\" rel=\"noopener\" target=\"_blank\"\u003e\u003cspan\u003eGet Started Here!\u003c\/span\u003e\u003c\/a\u003e\u003cspan\u003e \u003c\/span\u003e\u003c\/b\u003e\u003c\/em\u003e\u003c\/p\u003e\n\u003cul\u003e\u003c\/ul\u003e","published_at":"2026-02-11T11:53:06-07:00","created_at":"2023-07-25T13:21:18-06:00","vendor":"SKYTRAK","type":"","tags":["Products That Can Be Discounted","RetailPrice:2995.00","StyleNumber:ST-LMO-SKYTRA+","WholesalePrice:2516.00"],"price":199500,"price_min":199500,"price_max":199500,"available":true,"price_varies":false,"compare_at_price":299500,"compare_at_price_min":299500,"compare_at_price_max":299500,"compare_at_price_varies":false,"variants":[{"id":45901494485298,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"ST-LMO-SKYTRA+","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"name":"SKYTRAK ST+ Launch Monitor","public_title":null,"options":["Default Title"],"price":199500,"weight":0,"compare_at_price":299500,"inventory_management":"shopify","barcode":"854554004614","requires_selling_plan":false,"selling_plan_allocations":[],"quantity_rule":{"min":1,"max":null,"increment":1}}],"images":["\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SkyTrak_white_launch_monitor_with_14-day_free_trial_offer..jpg?v=1781033925","\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SKYTRAK_plus_Launch_Monitor_Side_View.jpg?v=1764023313","\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SKYTRAK_Plus_Launch_Monitor_Bundle_shopify.jpg?v=1764023313","\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Side_View_SKYTRAK_Launch_Monitor.jpg?v=1764023313","\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Back_of_SKYTRAK_plus_Launch_Monitor_shopify.jpg?v=1764023313","\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Connection_SKYTRAK_Launch_Monitor_shopify.jpg?v=1764023313","\/\/www.skytrakgolf.com\/cdn\/shop\/files\/ST-Courseplay.jpg?v=1773940203","\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Practicing_with_SKYTRAK_plus__Launch_Monitor.jpg?v=1764023313"],"featured_image":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SkyTrak_white_launch_monitor_with_14-day_free_trial_offer..jpg?v=1781033925","options":["Title"],"media":[{"alt":"White device with 'SkyTrak' branding on a white background, featuring a promotional offer for a free trial membership.","id":42693589401906,"position":1,"preview_image":{"aspect_ratio":1.0,"height":800,"width":800,"src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SkyTrak_white_launch_monitor_with_14-day_free_trial_offer..jpg?v=1781033925"},"aspect_ratio":1.0,"height":800,"media_type":"image","src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SkyTrak_white_launch_monitor_with_14-day_free_trial_offer..jpg?v=1781033925","width":800},{"alt":"Side view of the SKYTRAK+ launch monitor, Golf Monthly Editors Choice 2023","id":34642014175538,"position":2,"preview_image":{"aspect_ratio":1.25,"height":960,"width":1200,"src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SKYTRAK_plus_Launch_Monitor_Side_View.jpg?v=1764023313"},"aspect_ratio":1.25,"height":960,"media_type":"image","src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SKYTRAK_plus_Launch_Monitor_Side_View.jpg?v=1764023313","width":1200},{"alt":"SKYTRAK+, quick start guide, safety info, charging cords and block for your device all included","id":35152798613810,"position":3,"preview_image":{"aspect_ratio":1.5,"height":600,"width":900,"src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SKYTRAK_Plus_Launch_Monitor_Bundle_shopify.jpg?v=1764023313"},"aspect_ratio":1.5,"height":600,"media_type":"image","src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/SKYTRAK_Plus_Launch_Monitor_Bundle_shopify.jpg?v=1764023313","width":900},{"alt":"Side view of the SKYTRAK+ launch monitor, Golf Monthly Editors Choice 2023","id":34642014077234,"position":4,"preview_image":{"aspect_ratio":1.25,"height":960,"width":1200,"src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Side_View_SKYTRAK_Launch_Monitor.jpg?v=1764023313"},"aspect_ratio":1.25,"height":960,"media_type":"image","src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Side_View_SKYTRAK_Launch_Monitor.jpg?v=1764023313","width":1200},{"alt":"Back of the SKYTRAK+ Launch Monitor","id":34987170857266,"position":5,"preview_image":{"aspect_ratio":1.25,"height":960,"width":1200,"src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Back_of_SKYTRAK_plus_Launch_Monitor_shopify.jpg?v=1764023313"},"aspect_ratio":1.25,"height":960,"media_type":"image","src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Back_of_SKYTRAK_plus_Launch_Monitor_shopify.jpg?v=1764023313","width":1200},{"alt":"Top view of the SKYTRAK+ launch monitor, power and wifi check point","id":34642014142770,"position":6,"preview_image":{"aspect_ratio":1.25,"height":3596,"width":4495,"src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Connection_SKYTRAK_Launch_Monitor_shopify.jpg?v=1764023313"},"aspect_ratio":1.25,"height":3596,"media_type":"image","src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Connection_SKYTRAK_Launch_Monitor_shopify.jpg?v=1764023313","width":4495},{"alt":"Pebble Beach Course Play on the new SKYTRAK app ","id":40127430590770,"position":7,"preview_image":{"aspect_ratio":1.501,"height":533,"width":800,"src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/ST-Courseplay.jpg?v=1773940203"},"aspect_ratio":1.501,"height":533,"media_type":"image","src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/ST-Courseplay.jpg?v=1773940203","width":800},{"alt":"Woman hitting on an indoor golf simulator powered by SKYTRAK+ launch monitor","id":35152801431858,"position":8,"preview_image":{"aspect_ratio":1.498,"height":534,"width":800,"src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Practicing_with_SKYTRAK_plus__Launch_Monitor.jpg?v=1764023313"},"aspect_ratio":1.498,"height":534,"media_type":"image","src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/Practicing_with_SKYTRAK_plus__Launch_Monitor.jpg?v=1764023313","width":800},{"alt":"Video of at home golf sim studio garage setup ","id":38691656630578,"position":9,"preview_image":{"aspect_ratio":1.778,"height":720,"width":1280,"src":"\/\/www.skytrakgolf.com\/cdn\/shop\/files\/preview_images\/846c8174f0a5433ba58bcecb0d8ae764.thumbnail.0000000000.jpg?v=1719294965"},"aspect_ratio":1.775,"duration":30000,"media_type":"video","sources":[{"format":"mp4","height":480,"mime_type":"video\/mp4","url":"\/\/www.skytrakgolf.com\/cdn\/shop\/videos\/c\/vp\/846c8174f0a5433ba58bcecb0d8ae764\/846c8174f0a5433ba58bcecb0d8ae764.SD-480p-0.9Mbps-30864749.mp4?v=0","width":852},{"