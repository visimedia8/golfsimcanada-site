<style>
  .db-hero-media {
    width: 100%;
  }

  .db-hero-media__outer {
    max-width: 1400px;
    margin: 0 auto;
  }

  .db-hero-media__background {
    position: relative;
    overflow: hidden;
    border-radius: 0 0 10px 10px;
  }

  .db-hero-media__background img {
    border-radius: 0 0 10px 10px;
  }

  .db-hero-media__image,
  .db-hero-media__video {
    width: 100%;
    height: 600px;
    object-fit: cover;
  }

  .db-hero-media__video {
    display: block;
  }

  .db-hero-media__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: start;
    padding: 75px 150px;
  }

  .db-hero-media__content {
    max-width: 1000px;
    color: #ffffff;
  }

  .db-hero-media__slogan {
    font-size: 2rem;
    text-transform: uppercase;
    margin-bottom: 12px;
  }

  .db-hero-media__heading {
    font-size: 6rem;
    margin-top: 12px;
    color: inherit;
    text-transform: uppercase;
    max-width: 750px;
  }

  .db-hero-media__button-description {
    font-size: 1.8rem;
    margin: 10px 0 20px;
    max-width: 700px;
    line-height: 1.4;
    color: #ffffff;
  }

  .db-hero-media__buttons {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .db-hero-media__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 15px 40px;
    font-weight: 600;
    text-decoration: none;
    border-radius: 10px;
    line-height: 1;
  }

  .db-hero-media__button--primary {
    background: #6aeca5;
    color: #000000;
  }

  .db-hero-media__button--secondary {
    border: 2px solid #ffffff;
    color: #ffffff;
    background: #00000099;
  }

  @media (max-width: 1024px) {
    .db-hero-media__overlay {
      padding: 50px 100px;
    }

    .db-hero-media__heading {
      font-size: 5rem;
      max-width: 100%;
    }

    .db-hero-media__outer {
      max-width: 100%;
    }

    .db-hero-media__background {
      border-radius: 0;
    }

    .db-hero-media__background img {
      border-radius: 0;
    }
