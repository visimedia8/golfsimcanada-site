}

.db-reviews__container {
  position: relative;
  max-width: 1450px;
  margin: 0 auto;
  padding: 40px 40px 80px;
  color: #fff;
  background-image: var(--bg-image);
  background-size: cover;
  background-position: center;
  overflow: hidden;
}

/* Fade edges */
.db-reviews__container::before,
.db-reviews__container::after {
  content: "";
  position: absolute;
  top: 0;
  bottom: 0;
  width: 20%;
  z-index: 1;
  pointer-events: none;
}

.db-reviews__container::before {
  left: 0;
  background: linear-gradient(to right, #000 0%, transparent 100%);
}

.db-reviews__container::after {
  right: 0;
  background: linear-gradient(to left, #000 0%, transparent 100%);
}

.db-reviews__content {
  position: relative;
  z-index: 2;
}

.db-reviews__title {
  text-align: center;
  margin-bottom: 80px;
  font-size: 52px;
  text-transform: uppercase;
  color: #fff;
}

.db-reviews__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 30px;
}

.db-review {
  background: #272727aa;
  border: 1px solid #fff;
  border-radius: 14px;
  padding: 20px 20px 30px;
  text-align: center;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 10px;
}

.db-review__stars {
  color: #f5c96b;
  font-size: 32px;
  margin: 0;
}

.db-review__text {
  font-size: 16px;
  line-height: 24px;
  margin: 0 0 20px;
}

.db-review__name {
  font-weight: 700;
  font-size: 18px;
  line-height: 23px;
}

.db-review__desc {
  font-size: 14px;
  line-height: 19px;
  color: #aaa;
}

/* Mobile */
@media (max-width: 900px) {
  .db-reviews__grid {
    grid-template-columns: 1fr;
  }

  .db-reviews__container {
    padding: 70px 25px 90px;
  }

  .db-reviews__title {
    font-size: 36px;
    margin: 0;
  }
}
</style>

<section class="db-reviews">
