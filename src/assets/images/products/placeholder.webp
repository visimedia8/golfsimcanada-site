<div class="row-fluid ">
<div class="span12 widget-span widget-type-cell cell_16820140732162-padding dnd-column" style="" data-widget-type="cell" data-x="0" data-w="12">

<div class="row-fluid-wrapper row-depth-1 row-number-27 dnd-row">
<div class="row-fluid ">
<div class="span12 widget-span widget-type-custom_widget widget_1713444808102-hidden dnd-module" style="" data-widget-type="custom_widget" data-x="0" data-w="12">
<div id="hs_cos_wrapper_widget_1713444808102" class="hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_module" style="" data-hs-cos-general-type="widget" data-hs-cos-type="module"><div class="instagram-feed-module tw-flex tw-flex-wrap tw-items-center tw-gap-8 md:tw-flex-nowrap">
    
        <div class="tw-basis-full tw-grow md:tw-basis-1/2 lg:tw-basis-1/3">
            <div id="hs_cos_wrapper_widget_1713444808102_" class="hs_cos_wrapper hs_cos_wrapper_widget hs_cos_wrapper_type_inline_rich_text" style="" data-hs-cos-general-type="widget" data-hs-cos-type="inline_rich_text" data-hs-cos-field="richtext_field"><h2 class="text-4xl font-light mb-6">Love it? Share it! #mycarlsplace</h2>
<p class="text-sm">Our customers and their indoor golf builds are the real MVPs. No need for flashy photography tricks - their incredible creations speak volumes!</p>
<p class="text-sm">We love to see what your golf room looks like. Tag us and throw a quick #mycarlsplace on your post.</p>
<br>
<p><a href="https://www.instagram.com/carlsplacediygolf/" class="btn btn-brand button" rel="noopener">Share on Insta</a> &nbsp;&nbsp; <a href="/share-with-us" class="btn btn-accent button" rel="noopener">Send a Pic</a></p></div>
        </div>
    
    <div class="tw-basis-full tw-grow md:tw-basis-1/2 lg:tw-basis-2/3" x-data="initInstagramFeed()" x-init="init()">
        <div class="tw-grid tw-gap-1.5 tw-grid-cols-3 md:tw-grid-cols-2 lg:tw-grid-cols-3">
            <template x-for="feedItem in feedItems">
                <div x-html="feedItem"></div>
            </template>
        </div>
    </div>

<script>
    function initInstagramFeed() {
        return {
            feedItems: [],
            async init() {
                let self = this,
                    index = 1,
                    instagramFeedResponse = await this.getInstagramFeedJson();

                for (let instagramFeedResponseItem of instagramFeedResponse) {
                    self.feedItems.push(self.getInstagramItemHtml(instagramFeedResponseItem, index));
                    index++;
                }
            },
            async getInstagramFeedJson() {
                try {
                    let response = await fetch('https://shop.carlofet.com/api/instagramfeed/json');
                    let instagramFeedJson = await response.json();
                    instagramFeedJson = JSON.parse(instagramFeedJson.response).data;
                    instagramFeedJson = instagramFeedJson.slice(0, 6);

                    return instagramFeedJson;
                } catch (error) {
                    console.log('Instagram feed fetch error', error);
                }

                return [];
            },
            getInstagramItemHtml(instagramObject, index) {
                return `
                <div class="tw-relative tw-aspect-square tw-overflow-hidden tw-shadow" data-item-id="${index}">
                    <a class="tw-absolute tw-h-full tw-w-full" href="${instagramObject.permalink}" target="_blank">
                        <img class="tw-absolute tw-top-0 tw-left-0 tw-h-full tw-w-full tw-object-cover"
                            src="${instagramObject.media_url}"
                            loading="lazy"
                            alt="${instagramObject?.caption ? instagramObject?.caption : 'Carl\'s Place Instagram'}" />
                    </a>
                </div>
                `;
            }
        }
    }
</script></div>

</div><!--end widget-span -->
